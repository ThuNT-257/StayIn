        target: 2
        changeValue: -1
  - choiceID: choice_02
    config: {fileID: 11400000, guid: d3fe8218963b81d40a3592d31e93c699, type: 2}
    requiredItem: {fileID: 0}
    requiresCharacter: 0
    outcomes:
    - outcomeID: outcome_01
      isSuccess: 0
      outcomeText: Call us picky, but if a rat got to it first, they can keep it.
        We'll starve with dignity, thanks.
