  m_Script: {fileID: 11500000, guid: d21438f07bf2e8446b0a1da7bf64f675, type: 3}
  m_Name: Day6
  m_EditorClassIdentifier: 
  dayNumber: 6
  storyText: "The sky is gray today. Heavy clouds, no sun. Down below, a few zombies
    shuffle across the courtyard like they have nowhere to be \u2014 which is funny,
    because neither do we. We tried calling home. No one picked up. We tried again.
    And again. Nothing. The phone just rings into emptiness. Every little sound in
    this room now feels like a death sentence \u2014 a dropped spoon, a creaky chair,
    a cough we couldn't hold in. Funny how we used to ignore phone calls on purpose.
    Now we'd kill to hear a single \"hello.\"\r\n\r\n"
