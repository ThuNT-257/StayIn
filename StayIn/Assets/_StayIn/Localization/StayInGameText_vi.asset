  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: StayInGameText_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: cc57f5139c87a1343bea2fdf258dd1bf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 16938021700976640
    m_Localized: "Ch\xFAng t\xF4i t\u1EEBng mang t\u1EADn th\u1EBF ra l\xE0m tr\xF2
      \u0111\xF9a. Gi\u1EDD th\xEC ch\u1EB3ng ai c\u01B0\u1EDDi n\u1ED5i n\u1EEFa.
      L\xFAc \u0111\u1EA7u, c\u0103n tin v\u1EABn b\xECnh th\u01B0\u1EDDng \u0111\u1EBFn
      ph\xE1t ch\xE1n \u2014 m\u1ECDi ng\u01B0\u1EDDi \u0103n u\u1ED1ng, l\u0169
      v\u1ECBt th\xEC s\u0103n m\u1EA5y m\u1EA9u v\u1EE5n b\xE1nh nh\u01B0 l\u0169
      kh\u1EE7ng long t\xED hon. R\u1ED3i ch\xFAng t\xF4i b\u01B0\u1EDBc v\xE0o c\u1EEDa
      h\xE0ng ti\u1EC7n l\u1EE3i. N\u0103m ph\xFAt sau, ti\u1EBFng h\xE9t th\u1EA5t
      thanh vang l\xEAn. Nh\xECn qua t\u1EA5m k\xEDnh th\u1EE7y tinh, ch\xFAng t\xF4i
      th\u1EA5y ai \u0111\xF3 \u0111ang b\u1ECB \u0111u\u1ED5i b\u1EAFt. C\u1EE9
      t\u01B0\u1EDFng l\xE0 m\u1ED9t v\u1EE5 \u0111\xE1nh nhau. Cho \u0111\u1EBFn
      khi m\xE1u b\u1EAFn tung t\xF3e. \u1EEA, kh\xF4ng ph\u1EA3i \u0111\xE1nh nhau
      r\u1ED3i. Nh\u1EEFng ng\u01B0\u1EDDi b\u1ECB c\u1EAFn \u0111\u1EE9ng b\u1EADt
      d\u1EADy. D\u0129 nhi\xEAn l\xE0 ch\xFAng ph\u1EA3i \u0111\u1EE9ng d\u1EADy
      r\u1ED3i. C\u1EEDa h\xE0ng ti\u1EC7n l\u1EE3i tr\u1EDF n\xEAn h\u1ED7n lo\u1EA1n
      \u0111i\xEAn cu\u1ED3ng. Ch\xFAng t\xF4i c\u1EAFm \u0111\u1EA7u ch\u1EA1y l\xEAn
      t\u1EA7ng 5. May m\xE0 tho\xE1t. Tr\u01B0\u1EDDng \u0111\u1EA1i h\u1ECDc gi\u1EDD
      l\xE0 m\u1ED9t b\xE3i chi\u1EBFn tr\u01B0\u1EDDng h\u1ED7n \u0111\u1ED9n. Ti\u1EBFng
      la h\xE9t \u1EDF kh\u1EAFp m\u1ECDi n\u01A1i. C\xF2n t\u1ED3i t\u1EC7 h\u01A1n
      c\u1EA3 tr\xEAn phim. M\xE0 nh\xECn l\u1EA1i th\xEC h\xF4m nay t\u1EE5i m\xECnh
      v\u1EABn c\xF3 ti\u1EBFt h\u1ECDc \u0111\u1EA5y. Ch\u1EAFc l\xE0 b\xF9ng h\u1ECDc
      th\xF4i. C\xF2n l\u0169 v\u1ECBt \xE1? Ch\u1ECBu ch\u1EBFt. Ch\u1EAFc t\u1EE5i
      n\xF3 ch\u1EA1y c\xF2n nhanh h\u01A1n c\u1EA3 ch\xFAng t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 16939959825940480
    m_Localized: "\u0110\xEAm qua l\xE0 m\u1ED9t chu\u1ED7i nh\u1EEFng ti\u1EBFng
      la h\xE9t kh\xF4ng h\u1ED3i k\u1EBFt. \u0110\u1EBFn b\xECnh minh, m\u1ECDi
      th\u1EE9 b\u1ED7ng im \u1EAFng \u0111\u1EBFn r\u1EE3n ng\u01B0\u1EDDi. B\u1EA7u
      tr\u1EDDi xanh ng\u1EAFt, n\u1EAFng \u0111\u1EB9p \u2014 ho\xE0n to\xE0n l\u1EA1c
      qu\u1EBB v\u1EDBi nh\u1EEFng v\u1EC7t m\xE1u loang l\u1ED5 d\u01B0\u1EDBi s\xE2n
      tr\u01B0\u1EDDng. L\u0169 v\u1ECBt v\u1EABn l\u1EA1ch b\u1EA1ch \u0111i quanh
      t\xECm giun. H\xF3a ra b\u1ECDn zombie ch\u1EB3ng m\u1EA3y may quan t\xE2m
      \u0111\u1EBFn v\u1ECBt. \u0110\xFAng l\xE0 l\u0169 v\u1ECBt may m\u1EAFn. \u0110i\u1EC7n
      v\u1EABn ch\u01B0a m\u1EA5t. M\u1EA1ng x\xE3 h\u1ED9i th\xEC \u0111ang b\xF9ng
      n\u1ED5 \u2014 m\u1ED9t n\u1EEDa s\u1ED1 ng\u01B0\u1EDDi \u0111ang \u0111\xF9a
      c\u1EE3t v\u1EC1 vi\u1EC7c kh\xF4ng ph\u1EA3i \u0111i l\xE0m \u0111i h\u1ECDc
      n\u1EEFa, n\u1EEDa c\xF2n l\u1EA1i th\xEC kh\xF3c l\xF3c th\u1EA3m thi\u1EBFt.
      Qu\xE2n \u0111\u1ED9i v\u1EEBa \u0111\u0103ng m\u1ED9t th\xF4ng b\xE1o: h\xE3y
      \u1EA9n n\u1EA5p, gi\u1EEF im l\u1EB7ng, th\u1EA5y zombie l\xE0 ch\u1EA1y,
      v\xE0 ph\u1EA3i ti\u1EBFt ki\u1EC7m th\u1EE9c \u0103n. H\u1ECD b\u1EA3o h\u1ECD
      s\u1EBD t\xECm ra gi\u1EA3i ph\xE1p. \u0110\xE1ng l\u1EBD ra ch\xFAng t\xF4i
      ph\u1EA3i c\u1EA3m th\u1EA5y an t\xE2m h\u01A1n sau khi \u0111\u1ECDc n\xF3.
      Nh\u01B0ng kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16940414241030144
    m_Localized: "M\u1EA5y con m\xE8o \u1EDF c\u0103n tin v\u1EABn \u0111ang \u1EDF
      tr\xEAn m\xE1i nh\xE0. C\xE1i con m\xE8o m\u01B0\u1EDBp cam b\xE9o \xFA \u1EA5y
      \u0111\xE3 b\u1EA5t \u0111\u1ED9ng su\u1ED1t ba ng\xE0y nay r\u1ED3i. Ch\xFAng
      t\xF4i ch\u1EB3ng r\xF5 l\xE0 n\xF3 \u0111\xE3 ch\u1EBFt hay ch\u1EC9 l\xE0
      kh\xF4ng th\xE8m quan t\xE2m \u0111\u1EBFn s\u1EF1 \u0111\u1EDDi n\u1EEFa.
      S\xE1ng nay, ch\xFAng t\xF4i th\u1EA5y c\xF3 ai \u0111\xF3 \u1EDF ph\xEDa b\xEAn
      kia s\xE2n tr\u01B0\u1EDDng. C\u1EADu ta \u0111ang c\u1ED1 ti\u1EBFp c\u1EADn
      c\xE2y xo\xE0i n\u1EB1m gi\u1EEFa khu k\xFD t\xFAc x\xE1 v\xE0 c\u0103n tin.
      Nh\u01B0ng c\u1EADu ta \u0111\xE3 kh\xF4ng l\xE0m \u0111\u01B0\u1EE3c. M\u1ED9t
      con zombie \u0111\xE3 t\xF3m ch\u1EB7t l\u1EA5y c\u1ED5 ch\xE2n tr\u01B0\u1EDBc
      khi c\u1EADu ta k\u1ECBp leo l\xEAn. C\u1EADu ta h\xE9t l\xEAn th\u1EA3m thi\u1EBFt.
      Ch\xFAng t\xF4i ch\u1EC9 bi\u1EBFt \u0111\u1EE9ng nh\xECn t\u1EEB c\u1EEDa
      s\u1ED5. Ch\xFAng t\xF4i \u0111\xE3 kh\xF4ng gi\xFAp. M\xE0 th\u1EF1c ra l\xE0
      kh\xF4ng th\u1EC3 gi\xFAp. \u0110\u1EBFn khi con zombie kia \"xong vi\u1EC7c\"
      th\xEC \u0111\xE3 c\xF3 th\xEAm ba con n\u1EEFa lao v\xE0o x\xE2u x\xE9. Nh\u1EEFng
      qu\u1EA3 xo\xE0i th\xEC v\u1EABn l\u1EE7ng l\u1EB3ng tr\xEAn c\xE2y. M\u1EA5y
      con m\xE8o cu\u1ED1i c\xF9ng c\u0169ng ch\u1ECBu nh\xFAc nh\xEDch \u2014 t\u1EE5i
      n\xF3 ch\u1EA1y t\xF3t v\xE0o b\xEAn trong c\u0103n tin. \u0110\u1EBFn c\u1EA3
      l\u0169 m\xE8o c\xF2n bi\u1EBFt \u0111\u01B0\u1EDDng m\xE0 s\u1EE3."
    m_Metadata:
      m_Items: []
  - m_Id: 16940756185858048
    m_Localized: "H\xF4m nay tr\u1EDDi m\u01B0a. Nh\u1EEFng v\u1EC7t m\xE1u d\u01B0\u1EDBi
      s\xE2n tr\u01B0\u1EDDng \u0111ang b\u1ECB g\u1ED9t r\u1EEDa r\u1ED3i tr\xF4i
      tu\u1ED9t xu\u1ED1ng c\u1ED1ng. B\u1EB1ng m\u1ED9t c\xE1ch n\xE0o \u0111\xF3,
      c\u1EA3nh t\u01B0\u1EE3ng n\xE0y tr\xF4ng b\u1EDBt gi\u1ED1ng m\u1ED9t hi\u1EC7n
      tr\u01B0\u1EDDng v\u1EE5 \xE1n h\u01A1n, m\xE0 nh\xECn c\u1EE9 nh\u01B0 m\u1ED9t
      khu\xF4n vi\xEAn tr\u01B0\u1EDDng ng\xE0y m\u01B0a t\u1EA7m t\xE3. L\u0169
      m\xE8o \u0111ang tr\u1ED1n d\u01B0\u1EDBi m\xE1i hi\xEAn c\u0103n tin. B\u1ECDn
      zombie th\xEC di chuy\u1EC3n ch\u1EADm ch\u1EA1p h\u01A1n h\u1EB3n. \xCDt nh\u1EA5t
      th\xEC v\u1EDBi th\u1EDDi ti\u1EBFt n\xE0y, ch\xFAng t\xF4i \u0111\u1EE1 ph\u1EA3i
      gi\u1EB7t qu\u1EA7n \xE1o. R\u1ED3i ch\xFAng t\xF4i s\u1EF1c nh\u1EDB ra l\xE0
      m\xECnh \u0111\xE3 b\u1ED1n ng\xE0y r\u1ED3i ch\u01B0a gi\u1EB7t \u0111\u1ED3.
      \u0110\u1ED1i di\u1EC7n v\u1EDBi ch\xFAng t\xF4i l\xE0 t\xF2a nh\xE0 k\xFD
      t\xFAc x\xE1 b\xEAn kia. V\xE0i ph\xF2ng \u0111\xF3ng r\xE8m c\u1EEDa ch\u1EB7t
      m\xEDt. C\xF3 ph\xF2ng th\xEC r\xE8m b\u1ECB x\xE9 r\xE1ch t\u1EA3 t\u01A1i
      v\xE0 nhem nhu\u1ED1c nh\u1EEFng v\u1EC7t m\xE1u. C\xF3 nh\u1EEFng ph\xF2ng
      th\xEC ch\u1EC9 tr\u1ED1ng r\u1ED7ng. Hy v\u1ECDng l\xE0 b\xEAn \u0111\xF3
      v\u1EABn c\xF2n c\xF3 ai \u0111\xF3 s\u1ED1ng s\xF3t."
    m_Metadata:
      m_Items: []
  - m_Id: 16941067063476224
    m_Localized: "T\u1EEB ban c\xF4ng ph\xF2ng m\xECnh, ch\xFAng t\xF4i c\xF3 th\u1EC3
      nh\xECn sang t\xF2a nh\xE0 k\xFD t\xFAc x\xE1 \u0111\u1ED1i di\u1EC7n. Hai
      t\u1EA7ng ph\xEDa d\u01B0\u1EDBi l\xE0 nh\u1EEFng sinh vi\xEAn \u0111\u1EA1i
      h\u1ECDc gi\u1ED1ng nh\u01B0 ch\xFAng t\xF4i. C\xF2n ba t\u1EA7ng ph\xEDa tr\xEAn
      l\xE0 t\u1EE5i h\u1ECDc sinh c\u1EA5p ba. T\u1EE5i n\xF3 th\u1EADt may m\u1EAFn
      \u2014 t\u1EA5t c\u1EA3 \u0111\xE3 k\u1ECBp v\u1EC1 nh\xE0 v\u1EDBi b\u1ED1
      m\u1EB9 tr\u01B0\u1EDBc khi m\u1ECDi chuy\u1EC7n \u1EADp \u0111\u1EBFn. Ch\xFAng
      t\xF4i th\xEC kh\xF4ng \u0111\u01B0\u1EE3c may m\u1EAFn nh\u01B0 v\u1EADy.
      Ch\xFAng t\xF4i \u0111\xE3 \u1EDF l\u1EA1i. V\xEC nh\u1EEFng k\u1EF3 thi. V\xEC
      m\u1EA5y phong l\u01B0\u01A1ng kh\xF4. V\xEC m\u1ED9t \u0111i\u1EC1u v\xF4
      ngh\u0129a n\xE0o \u0111\xF3. Gi\u1EDD \u0111\xE2y, nh\u1EEFng khung c\u1EEDa
      s\u1ED5 ph\xF2ng t\u1EE5i n\xF3 t\u1ED1i om. Nh\u1EEFng c\u0103n ph\xF2ng tr\u1ED1ng
      ho\xE1c. Ch\xFAng t\xF4i hy v\u1ECDng t\u1EE5i n\xF3 \u0111ang \u0111\u01B0\u1EE3c
      an to\xE0n b\xEAn gia \u0111\xECnh. Hy v\u1ECDng gia \u0111\xECnh t\u1EE5i
      n\xF3 c\u0169ng b\xECnh an v\xF4 s\u1EF1. Nh\u01B0ng r\u1ED3i ch\xFAng t\xF4i
      l\u1EA1i c\u1ED1 kh\xF4ng ngh\u0129 ng\u1EE3i s\xE2u xa xem c\xE1i t\u1EEB
      \"an to\xE0n\" v\xE0o th\u1EDDi \u0111i\u1EC3m n\xE0y r\u1ED1t cu\u1ED9c c\xF2n
      c\xF3 ngh\u0129a l\xFD g\xEC n\u1EEFa hay kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16941399168466944
    m_Localized: "B\u1EA7u tr\u1EDDi h\xF4m nay x\xE1m x\u1ECBt. M\xE2y \u0111en
      gi\u0103ng l\u1ED1i, ch\u1EB3ng ch\xFAt \xE1nh n\u1EAFng. Ph\xEDa d\u01B0\u1EDBi
      s\xE2n, v\xE0i con zombie b\u01B0\u1EDBc \u0111i nh\u1EEFng b\u01B0\u1EDBc
      k\xE9o l\xEA v\xF4 \u0111\u1ECBnh nh\u01B0 th\u1EC3 t\u1EE5i n\xF3 ch\u1EB3ng
      c\xF3 n\u01A1i n\xE0o \u0111\u1EC3 \u0111i \u2014 ngh\u0129 c\u0169ng bu\u1ED3n
      c\u01B0\u1EDDi, v\xEC ch\xFAng t\xF4i b\xE2y gi\u1EDD c\u0169ng kh\xE1c g\xEC
      \u0111\xE2u. Ch\xFAng t\xF4i \u0111\xE3 th\u1EED g\u1ECDi \u0111i\u1EC7n v\u1EC1
      nh\xE0. Ch\u1EB3ng ai nh\u1EA5c m\xE1y. Ch\xFAng t\xF4i th\u1EED l\u1EA1i l\u1EA7n
      n\u1EEFa. R\u1ED3i l\u1EA1i l\u1EA7n n\u1EEFa. V\u1EABn l\xE0 con s\u1ED1 kh\xF4ng.
      Ti\u1EBFng chu\xF4ng \u0111i\u1EC7n tho\u1EA1i c\u1EE9 reo vang r\u1ED3i ch\xECm
      v\xE0o kho\u1EA3ng kh\xF4ng v\xF4 t\u1EADn. Gi\u1EDD \u0111\xE2y, m\u1ED7i
      m\u1ED9t \xE2m thanh nh\u1ECF nh\u1EB7t trong c\u0103n ph\xF2ng n\xE0y \u0111\u1EC1u
      gi\u1ED1ng nh\u01B0 m\u1ED9t b\u1EA3n \xE1n t\u1EED h\xECnh \u2014 m\u1ED9t
      chi\u1EBFc th\xECa b\u1ECB r\u01A1i, m\u1ED9t chi\u1EBFc gh\u1EBF ti\u1EBFng
      k\xEAu k\xF3t k\xE9t, hay m\u1ED9t ti\u1EBFng ho m\xE0 ch\xFAng t\xF4i kh\xF4ng
      th\u1EC3 k\xECm l\u1EA1i \u0111\u01B0\u1EE3c. N\u1EF1c c\u01B0\u1EDDi th\u1EADt,
      tr\u01B0\u1EDBc \u0111\xE2y ch\xFAng t\xF4i t\u1EEBng c\u1ED1 t\xECnh l\u1EDD
      \u0111i nh\u1EEFng cu\u1ED9c g\u1ECDi. C\xF2n b\xE2y gi\u1EDD, ch\xFAng t\xF4i
      s\u1EB5n s\xE0ng \u0111\xE1nh \u0111\u1ED5i m\u1ECDi th\u1EE9 ch\u1EC9 \u0111\u1EC3
      \u0111\u01B0\u1EE3c nghe th\u1EA5y m\u1ED9t ti\u1EBFng \"alo\"."
    m_Metadata:
      m_Items: []
  - m_Id: 16941727293063168
    m_Localized: "L\u01B0\u1EDBt m\u1EA1ng x\xE3 h\u1ED9i h\xF4m nay \u0111\xFAng
      l\xE0 m\u1ED9t sai l\u1EA7m. \u0110\xE2u \u0111\xE2u c\u0169ng l\xE0 tin x\u1EA5u
      \u2014 c\xE1c th\xE0nh ph\u1ED1 th\u1EA5t th\u1EE7, c\xE1c tuy\u1EBFn ti\u1EBFp
      t\u1EBF b\u1ECB c\u1EAFt \u0111\u1EE9t, ng\u01B0\u1EDDi ng\u01B0\u1EDDi nh\xE0
      nh\xE0 n\xF3i l\u1EDDi ly bi\u1EC7t. Ch\u1EB3ng c\xF3 th\xF4ng tin ch\xEDnh
      th\u1EE9c n\xE0o c\u1EA3. Ch\u1EC9 c\xF3 n\u1ED7i ho\u1EA3ng lo\u1EA1n \u0111ang
      hi\u1EC7n h\xECnh qua t\u1EEBng d\xF2ng ch\u1EEF. Ch\xFAng t\xF4i v\u1EABn
      \u0111ang c\u1ED1 th\u1EE7 trong ph\xF2ng, d\u1ECFng tai nghe ng\xF3ng ngo\xE0i
      h\xE0nh lang nh\u01B0 th\u1EC3 c\xE1i l\u1ED1i \u0111i \u0111\xF3 l\xE0 m\u1ED9t
      sinh v\u1EADt s\u1ED1ng. C\u1EE9 t\u1EF1 h\u1ECFi khi n\xE0o th\xEC c\xF3 ng\u01B0\u1EDDi
      \u0111\u1EBFn. Li\u1EC7u c\xF3 ai \u0111\u1EBFn hay kh\xF4ng. Qu\xE2n \u0111\u1ED9i
      t\u1EEBng n\xF3i h\u1ECD s\u1EBD t\xECm ra gi\u1EA3i ph\xE1p. \u0110\xF3 l\xE0
      chuy\u1EC7n c\u1EE7a m\u1EA5y ng\xE0y tr\u01B0\u1EDBc r\u1ED3i. Ngh\u0129 c\u0169ng
      n\u1EF1c c\u01B0\u1EDDi \u2014 t\xF4i t\u1EEBng than v\xE3n su\u1ED1t ng\xE0y
      v\u1EC1 deadline. C\u1EE9 d\u1ED3n d\u1EADp m\u01B0\u1EDDi c\xE1i deadline
      m\u1ED9t l\xFAc l\xE0 t\xF4i mu\u1ED1n ph\xE1t \u0111i\xEAn l\xEAn \u0111\u01B0\u1EE3c.
      C\xF2n b\xE2y gi\u1EDD \xE1? Cho t\xF4i xin c\u1EA3 m\u01B0\u1EDDi c\xE1i \u0111i.
      Cho t\xF4i thi cu\u1ED1i k\u1EF3 lu\xF4n c\u0169ng \u0111\u01B0\u1EE3c. Cho
      t\xF4i l\xE0m b\xE0i t\u1EADp nh\xF3m v\u1EDBi nh\u1EEFng \u0111\u1EE9a \u0111\u1ED3ng
      \u0111\u1ED9i t\u1ED3i t\u1EC7 nh\u1EA5t c\xF3 th\u1EC3 t\u01B0\u1EDFng t\u01B0\u1EE3ng
      ra lu\xF4n \u0111i. T\xF4i th\u1EC1 l\xE0 s\u1EBD c\xE2n h\u1EBFt, c\xE1i n\xE0y
      v\u1EEBa xong l\xE0 chi\u1EBFn c\xE1i ti\u1EBFp theo ngay, ch\u1EC9 \u0111\u1EC3
      \u0111\u1ED5i l\u1EA5y m\u1ED9t c\xE1i ng\xE0y h\u1EA1n \u0111\u1ECBnh thay
      v\xEC ph\u1EA3i ch\u1ECBu \u0111\u1EF1ng s\u1EF1 im l\u1EB7ng ch\u1EBFt ch\xF3c
      n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 16941929722757120
    m_Localized: "T\u1EEB ban c\xF4ng, ch\xFAng t\xF4i nh\xECn xu\u1ED1ng khu v\u01B0\u1EDDn
      bao quanh k\xFD t\xFAc x\xE1 c\u1EE7a m\xECnh. C\xE2y c\u1ED1i v\u1EABn xanh
      t\u01B0\u01A1i. C\u1ECF d\u1EA1i th\xEC \u0111\xE3 m\u1ECDc um t\xF9m. V\xE0
      r\u1ED3i ch\xFAng t\xF4i nh\xECn th\u1EA5y h\u1ECD \u2014 nh\u1EEFng b\xF3ng
      ng\u01B0\u1EDDi \u0111ang c\xFAi th\u1EA5p, di chuy\u1EC3n ch\u1EADm r\xE3i,
      l\xE9n l\xFAt ti\u1EBFn v\u1EC1 ph\xEDa c\u0103n tin. Kh\xF4ng ph\u1EA3i zombie.
      L\xE0 nh\u1EEFng ng\u01B0\u1EDDi s\u1ED1ng s\xF3t. Gi\u1ED1ng nh\u01B0 ch\xFAng
      t\xF4i. H\u1ECD \u0111ang \u0111i t\xECm th\u1EE9c \u0103n. \u0110\u1ED3 h\u1ED9p,
      m\xEC \u0103n li\u1EC1n, b\u1EA5t c\u1EE9 th\u1EE9 g\xEC c\xF2n s\xF3t l\u1EA1i.
      Ch\xFAng t\xF4i t\u1EEBng than phi\u1EC1n su\u1ED1t ng\xE0y v\u1EC1 \u0111\u1ED3
      \u0103n c\u0103n tin. Qu\xE1 m\u1EB7n. Qu\xE1 \u0111\u1EAFt. L\xFAc n\xE0o
      c\u0169ng ch\u1EC9 c\xF3 m\u1EA5y m\xF3n quen thu\u1ED9c. C\xF2n b\xE2y gi\u1EDD
      \xE1? Ch\u1EC9 c\u1EA7n m\u1ED9t \u1ED5 b\xE1nh m\xEC g\u1ED1i \u0111\xE3 ch\u1EDBm
      c\u0169 th\xF4i c\u0169ng \u0111\u1EE7 th\u1EA5y nh\u01B0 m\u1ED9t b\u1EEFa
      \u0111\u1EA1i ti\u1EC7c r\u1ED3i. N\u1EF1c c\u01B0\u1EDDi th\u1EADt, m\u1ECDi
      th\u1EE9 thay \u0111\u1ED5i nhanh qu\xE1. Th\u1EE9c \u0103n t\u1EEBng l\xE0
      th\u1EE9 ch\xFAng t\xF4i ch\u1EB3ng m\u1EA5y khi b\u1EADn t\xE2m. Gi\u1EDD
      \u0111\xE2y, n\xF3 l\xE0 th\u1EE9 duy nh\u1EA5t l\u1EA5p \u0111\u1EA7y t\xE2m
      tr\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 16942100074414080
    m_Localized: "B\u1EA7u tr\u1EDDi l\u1EA1i xanh ng\u1EAFt m\u1ED9t m\xE0u \u2014
      \u0111\u1EB9p \u0111\u1EBD, c\u1EE9 nh\u01B0 th\u1EC3 th\u1EBF gi\u1EDBi n\xE0y
      \u0111ang tr\xEAu ng\u01B0\u01A1i ch\xFAng t\xF4i v\u1EADy. Con m\xE8o m\u01B0\u1EDBp
      cam b\xE9o \xFA \u0111\xE3 quay l\u1EA1i v\u1EDBi th\xF3i quen c\u0169, l\u1EA1ch
      b\u1EA1ch \u0111i quanh s\xE2n tr\u01B0\u1EDDng v\xE0 t\xECm c\xE1ch tr\xEAu
      ch\u1ECDc l\u0169 v\u1ECBt. L\u0169 v\u1ECBt th\xEC ch\u1EB3ng th\xE8m n\u1EC3
      nang g\xEC. T\u1EE5i n\xF3 x\xEC x\xEC c\u1EA3nh c\xE1o. Con m\xE8o th\u1EE5t
      l\xF9i l\u1EA1i. R\u1ED3i sau \u0111\xF3 l\u1EA1i th\u1EED ti\u1EBFp. V\u1EABn
      l\xE0 c\xE1i \u0111i\u1EC7u b\u1ED9 \u0111\xF3, ng\xE0y n\xE0o c\u0169ng nh\u01B0
      ng\xE0y n\xE0o. \xCDt nh\u1EA5t th\xEC v\u1EABn c\xF3 \u0111\u1EE9a \u0111ang
      t\xECm th\u1EA5y ni\u1EC1m vui. C\xF2n ch\xFAng t\xF4i th\xEC ch\u1EC9 ng\u1ED3i
      \u0111\xE2y, l\u01B0\u1EDBt m\u1EA1ng x\xE3 h\u1ED9i v\xF4 \u0111\u1ECBnh,
      g\u1EEDi tin nh\u1EAFn cho b\u1EA5t c\u1EE9 ai m\xE0 m\xECnh quen bi\u1EBFt.
      B\u1EA1n b\xE8. B\u1EA1n c\xF9ng l\u1EDBp. Th\u1EADm ch\xED l\xE0 c\xE1i g\xE3
      trong nh\xF3m b\xE0i t\u1EADp l\u1EDBn m\xE0 ch\xFAng t\xF4i v\u1ED1n ch\u1EB3ng
      \u01B0a n\u1ED5i. Kh\xF4ng m\u1ED9t l\u1EDDi h\u1ED3i \u0111\xE1p. Ho\u1EB7c
      t\u1ED3i t\u1EC7 h\u01A1n \u2014 nh\u1EEFng tin nh\u1EAFn ph\u1EA3n h\u1ED3i
      t\u1EEB ng\u01B0\u1EDDi nh\xE0 c\u1EE7a h\u1ECD, n\xF3i r\u1EB1ng ch\xEDnh
      h\u1ECD c\u0169ng b\u1EB7t v\xF4 \xE2m t\xEDn v\u1EC1 con em m\xECnh. Ch\xFAng
      t\xF4i ch\u1EB3ng r\xF5 \u0111i\u1EC1u g\xEC m\u1EDBi l\xE0 t\u1ED3i t\u1EC7
      h\u01A1n n\u1EEFa: s\u1EF1 im l\u1EB7ng ch\u1EBFt ch\xF3c hay m\u1ED9t l\u1EDDi
      x\xE1c nh\u1EADn ph\u0169 ph\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16942351090925568
    m_Localized: "Ch\xFAng t\xF4i \u0111ang ng\u1ED3i trong im l\u1EB7ng th\xEC \u0111\u1ED9t
      nhi\xEAn \u2014 c\xF3 ti\u1EBFng b\u01B0\u1EDBc ch\xE2n. Ti\u1EBFng ch\u1EA1y.
      R\u1EA5t nhanh. Ngay b\xEAn ngo\xE0i h\xE0nh lang. R\u1ED3i m\u1ED9t ti\u1EBFng
      g\u1EA7m g\u1EEB. Th\u1EA5p, nh\u1EDBp nh\xFAa v\xE0 th\xE8m kh\xE1t. Con zombie
      \u0111ang \u0111u\u1ED5i theo ai \u0111\xF3. Ch\xFAng t\xF4i kh\xF4ng m\u1EDF
      c\u1EEDa. C\u0169ng kh\xF4ng d\xE1m nh\xECn qua l\u1ED7 nh\xF2m. C\u1EA3 l\u0169
      c\u1EE9 ng\u1ED3i im thin th\xEDt t\u1EA1i ch\u1ED7, ng\u01B0\u1EDDi \u0111\xF4ng
      c\u1EE9ng l\u1EA1i, d\u1ECFng tai l\xEAn nghe. Ti\u1EBFng ch\u1EA1y ng\xE0y
      m\u1ED9t l\u1EDBn h\u01A1n. R\u1ED3i ti\u1EBFng la h\xE9t b\u1EAFt \u0111\u1EA7u
      vang l\xEAn. M\u1ED9t ti\u1EBFng h\xE9t ng\u1EAFn ng\u1EE7i. B\u1ECB c\u1EAFt
      \u0111\u1EE9t qu\xE1 nhanh. R\u1ED3i sau \u0111\xF3 kh\xF4ng c\xF2n g\xEC c\u1EA3.
      Ch\u1EC9 c\xF2n ti\u1EBFng g\u1EA7m g\u1EEB. R\u1ED3i \u0111\u1EBFn c\u1EA3
      \xE2m thanh \u0111\xF3 c\u0169ng t\u1EAFt l\u1ECBm. \u0110\xEAm qua ch\xFAng
      t\xF4i \u0111\xE3 kh\xF4ng ng\u1EE7 ngon. M\xE0 th\u1EF1c ra, ch\xFAng t\xF4i
      ch\u1EB3ng th\u1EC3 ch\u1EE3p m\u1EAFt n\u1ED5i l\u1EA5y m\u1ED9t gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 16942564023156736
    m_Localized: "B\u1EA7u tr\u1EDDi l\u1EA1i x\xE1m x\u1ECBt m\u1ED9t m\xE0u. Nh\u1EEFng
      \u0111\xE1m m\xE2y n\u1EB7ng tr\u0129u s\xE0 xu\u1ED1ng th\u1EA5p nh\u01B0
      th\u1EC3 \u0111ang mu\u1ED1n ch\u1EA1m v\xE0o m\u1EB7t \u0111\u1EA5t. Nh\u01B0ng
      l\u0169 v\u1ECBt th\xEC v\u1EABn \u1EDF \u0111\xF3. T\u1EE5i n\xF3 l\u1EA1ch
      b\u1EA1ch \u0111i quanh s\xE2n tr\u01B0\u1EDDng nh\u01B0 th\u1EC3 ch\u1EB3ng
      c\xF3 chuy\u1EC7n g\xEC thay \u0111\u1ED5i. S\xE1ng nay ch\xFAng t\xF4i \u0111\xE3
      ng\u1ED3i ng\u1EAFm t\u1EE5i n\xF3 m\u1ED9t l\xFAc. Ng\u1ED3i \u0111\u1EBFm
      th\u1EED xem. Ch\xEDn. M\u01B0\u1EDDi. M\u01B0\u1EDDi m\u1ED9t con. V\u1EABn
      l\xE0 s\u1ED1 l\u01B0\u1EE3ng nh\u01B0 m\u1ECDi khi. Ch\u1EB3ng m\u1EA5t \u0111i
      con n\xE0o. Ch\u1EB3ng c\xF3 con n\xE0o b\u1ECB c\u1EAFn. C\u0169ng ch\u1EB3ng
      c\xF3 con v\u1ECBt n\xE0o bi\u1EBFn th\xE0nh zombie c\u1EA3. Ch\xFAng t\xF4i
      kh\xF4ng r\xF5 l\xFD do t\u1EA1i sao. C\xF3 th\u1EC3 b\u1ECDn zombie kh\xF4ng
      th\xEDch th\u1ECBt v\u1ECBt. C\xF3 th\u1EC3 l\u0169 v\u1ECBt ch\u1EA1y nhanh
      h\u01A1n c\xE1i v\u1EBB ngo\xE0i c\u1EE7a t\u1EE5i n\xF3. Ho\u1EB7c c\xF3 l\u1EBD
      \u2014 v\xE0 \u0111\xE2y l\xE0 m\u1ED9t suy ngh\u0129 kh\xE1 bu\u1ED3n c\u01B0\u1EDDi
      \u2014 c\xF3 l\u1EBD l\u0169 v\u1ECBt l\xE0 nh\u1EEFng sinh v\u1EADt duy nh\u1EA5t
      hi\u1EC3u ra \u0111\u01B0\u1EE3c quy lu\u1EADt \u1EDF \u0111\xE2y. C\u1EE9
      c\xFAi th\u1EA5p ng\u01B0\u1EDDi xu\u1ED1ng. T\u1EE5i n\xF3 lu\xF4n \u0111i
      c\xF9ng nhau. V\xE0 kh\xF4ng g\xE2y ra ti\u1EBFng \u0111\u1ED9ng. Ch\xFAng
      t\xF4i \u0111ang ghi ch\xE9p l\u1EA1i b\xE0i h\u1ECDc n\xE0y \u0111\xE2y. D\xF9
      bi\u1EBFt l\xE0 n\xF3 c\u0169ng ch\u1EB3ng gi\xFAp \xEDch \u0111\u01B0\u1EE3c
      g\xEC nhi\u1EC1u."
    m_Metadata:
      m_Items: []
  - m_Id: 16942768130572288
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i ng\u1ED3i l\u1EA1i v\u1EDBi nhau v\xE0
      c\u1ED1 g\u1EAFng ph\xE2n t\xEDch m\u1ECDi chuy\u1EC7n. \u0110\xE3 bao nhi\xEAu
      ng\xE0y tr\xF4i qua r\u1ED3i nh\u1EC9? C\u1EA3m gi\xE1c nh\u01B0 \u0111\xE3
      nhi\u1EC1u tu\u1EA7n. C\u1EA3m gi\xE1c nh\u01B0 \u0111\xE3 c\u1EA3 n\u0103m
      tr\u1EDDi. C\u1EE9 nh\u01B0 th\u1EC3 th\u1EDDi gian \u0111\xE3 ng\u1EEBng tr\xF4i
      v\xE0 ch\xFAng t\xF4i ch\u1EC9 \u0111ang\u2026 ch\u1EDD \u0111\u1EE3i. C\u1EA3
      l\u0169 l\u1EA1i ki\u1EC3m \u0111\u1EBFm l\u1EA1i s\u1ED1 nhu y\u1EBFu ph\u1EA9m
      c\u1EE7a m\xECnh. L\u01B0\u01A1ng kh\xF4: s\u1EAFp c\u1EA1n. N\u01B0\u1EDBc:
      c\xF2n \xEDt h\u01A1n. Thu\u1ED1c men: g\u1EA7n nh\u01B0 ch\u1EB3ng c\xF2n
      g\xEC. Hy v\u1ECDng: kh\xF4ng th\u1EC3 x\xE1c \u0111\u1ECBnh. Ch\xFAng t\xF4i
      b\xE0n v\u1EDBi nhau v\u1EC1 c\xE1c k\u1EBF ho\u1EA1ch ch\u1EA1y tr\u1ED1n.
      Xu\u1ED1ng b\u1EB1ng \u0111\u01B0\u1EDDng c\u1EA7u thang b\u1ED9 \u01B0? Qu\xE1
      nhi\u1EC1u zombie. B\u0103ng qua s\xE2n th\u01B0\u1EE3ng sao? Qu\xE1 xa. Ch\u1EDD
      c\u1EE9u h\u1ED9 \xE0? \u0110\xF3 ch\xEDnh l\xE0 k\u1EBF ho\u1EA1ch hi\u1EC7n
      t\u1EA1i \u0111\u1EA5y. N\xF3 ch\u1EB3ng ph\u1EA3i m\u1ED9t k\u1EBF ho\u1EA1ch
      kh\u1EA3 thi cho l\u1EAFm. Ch\xFAng t\xF4i c\u0169ng ph\xE2n t\xEDch c\u1EA3
      l\u0169 zombie n\u1EEFa. T\u1EE5i n\xF3 ch\u1EADm h\u01A1n khi tr\u1EDDi m\u01B0a.
      Nhanh h\u01A1n v\xE0o ban \u0111\xEAm. V\xE0 l\xFAc n\xE0o c\u0169ng th\xE8m
      kh\xE1t m\xE1u th\u1ECBt. Ch\xFAng t\xF4i v\u1EABn ch\u1EB3ng bi\u1EBFt c\xE1i
      g\xEC \u0111\xE3 kh\u01A1i m\xE0o cho \u0111\u1ED1ng h\u1ED7n \u0111\u1ED9n
      n\xE0y. Kh\xF4ng bi\u1EBFt n\xF3 l\xE2y lan ra sao. Ch\u1EB3ng bi\u1EBFt m\u1ED9t
      c\xE1i g\xEC h\u1EBFt. Nh\u01B0ng d\xF9 v\u1EADy, c\u1EA3 l\u0169 v\u1EABn
      c\u1EE9 ng\u1ED3i xu\u1ED1ng v\xE0 ph\xE2n t\xEDch nh\u01B0 th\u1EADt. Vi\u1EC7c
      \u0111\xF3 gi\xFAp ch\xFAng t\xF4i c\u1EA3m th\u1EA5y m\xECnh th\xF4ng th\xE1i
      \u0111\u01B0\u1EE3c \u0111\xE2u \u0111\xF3 ch\u1EEBng n\u0103m ph\xFAt. \u0110\u1EC3
      r\u1ED3i sau \u0111\xF3, th\u1EF1c t\u1EA1i l\u1EA1i t\xE1t th\u1EB3ng v\xE0o
      m\u1EB7t."
    m_Metadata:
      m_Items: []
  - m_Id: 16942897986224128
    m_Localized: "H\xF4m nay c\xF3 bi\u1EBFn. Kh\xF4ng ph\u1EA3i chuy\u1EC7n g\xEC
      qu\xE1 to t\xE1t. Ch\u1EB3ng gi\u1ED1ng nh\u01B0 ng\xE0y \u0111\u1EA7u ti\xEAn.
      Nh\u01B0ng \u0111\xFAng l\xE0 c\xF3 bi\u1EBFn th\u1EADt. V\xE0o kho\u1EA3ng
      gi\u1EEFa tr\u01B0a, ch\xFAng t\xF4i nghe th\u1EA5y m\u1ED9t ti\u1EBFng r\u1EA7m
      l\u1EDBn ph\xE1t ra t\u1EEB b\xEAn d\u01B0\u1EDBi. Ti\u1EBFng k\xEDnh v\u1EE1
      tan t\xE0nh. R\u1ED3i ti\u1EBFng c\xF2i b\xE1o \u0111\u1ED9ng c\u1EE7a m\u1ED9t
      chi\u1EBFc \xF4 t\xF4 b\u1EAFt \u0111\u1EA7u r\xFA l\xEAn inh \u1ECFi. N\xF3
      c\u1EE9 k\xEAu su\u1ED1t m\u1EA5y ph\xFAt li\u1EC1n. Ho\u1EB7c c\xF3 khi l\xE0
      v\xE0i ti\u1EBFng \u0111\u1ED3ng h\u1ED3. Th\u1EDDi gian gi\u1EDD \u0111\xE2y
      c\u1EE9 m\u1EDD m\u1ECBt c\u1EA3 r\u1ED3i. Ch\xFAng t\xF4i nh\xECn ra ngo\xE0i
      c\u1EEDa s\u1ED5 \u2014 m\u1ED9t chi\u1EBFc xe h\u01A1i \u0111\xE3 \u0111\xE2m
      s\u1EA7m v\xE0o b\u1EE9c t\u01B0\u1EDDng c\u0103n tin. T\xE0i x\u1EBF \u0111\xE3
      bi\u1EBFn m\u1EA5t. Ho\u1EB7c c\xF3 khi ngay t\u1EEB \u0111\u1EA7u \u0111\xE3
      ch\u1EB3ng c\xF3 ai \u1EDF \u0111\xF3. L\u0169 zombie b\u1EAFt \u0111\u1EA7u
      t\u1EE5 t\u1EADp l\u1EA1i quanh n\u01A1i ph\xE1t ra \xE2m thanh, t\u1EE5i n\xF3
      va r\u1EA7m r\u1EA7m v\xE0o nhau tr\xF4ng ch\u1EB3ng kh\xE1c g\xEC m\u1EA5y
      b\xE0 n\u1ED9i tr\u1EE3 \u0111ang l\xF3ng ng\xF3ng \u0111i mua s\u1EAFm. M\u1ED9t
      con trong s\u1ED1 \u0111\xF3 v\u1EA5p ph\u1EA3i m\u1ED9t con v\u1ECBt. Con
      v\u1ECBt qu\u1EA1c l\xEAn m\u1ED9t ti\u1EBFng. R\u1EA5t to. Ch\xFAng t\xF4i
      n\xEDn th\u1EDF. L\u0169 zombie l\u1EADp t\u1EE9c quay ngo\u1EAFt \u0111\u1EA7u
      l\u1EA1i. Con v\u1ECBt c\u1EAFm \u0111\u1EA7u ch\u1EA1y. L\u0169 zombie \u0111u\u1ED5i
      theo sau. Trong v\xE0i gi\xE2y ng\u1EAFn ng\u1EE7i \u0111\xF3, ch\xFAng t\xF4i
      b\u1ED7ng qu\xEAn m\u1EA5t l\xE0 m\xECnh \u0111ang s\u1EE3 h\xE3i. R\u1ED3i
      ti\u1EBFng c\xF2i b\xE1o \u0111\u1ED9ng t\u1EAFt l\u1ECBm. S\u1EF1 im l\u1EB7ng
      ch\u1EBFt ch\xF3c quay tr\u1EDF l\u1EA1i. \xC0 m\xE0 n\xF3i lu\xF4n l\xE0 con
      v\u1ECBt \u0111\xF3 \u0111\xE3 tho\xE1t ch\u1EBFt nh\xE9. Ch\xFAng t\xF4i th\u1EA5y
      n\xF3 l\u1EA1i l\u1EA1ch b\u1EA1ch b\u01B0\u1EDBc \u0111i nh\u01B0 th\u1EC3
      ch\u01B0a t\u1EEBng c\xF3 chuy\u1EC7n g\xEC x\u1EA3y ra. \u0110\xFAng l\xE0
      m\u1ED9t huy\u1EC1n tho\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 16943140479909888
    m_Localized: "\u0110\xEAm qua, ch\xFAng t\xF4i nghe th\u1EA5y ti\u1EBFng c\xE0o
      c\u1EEDa. Kh\xF4ng qu\xE1 l\u1EDBn. C\u0169ng kh\xF4ng d\u1ED3n d\u1EADp. Ch\u1EC9
      l\xE0\u2026 ch\u1EADm r\xE3i. \u0110\u1EA7y c\u1ED1 \xFD. C\u1EE9 nh\u01B0
      th\u1EC3 c\xE1i th\u1EE9 b\xEAn ngo\xE0i bi\u1EBFt th\u1EEBa ch\xFAng t\xF4i
      \u0111ang \u1EDF trong n\xE0y. C\u1EA3 l\u0169 kh\xF4ng d\xE1m c\u1EED \u0111\u1ED9ng.
      Kh\xF4ng d\xE1m c\u1EA3 th\u1EDF. Ti\u1EBFng c\xE0o d\u1EEBng l\u1EA1i. R\u1ED3i
      sau \u0111\xF3 l\u1EA1i ti\u1EBFp t\u1EE5c vang l\xEAn. L\u1EA7n n\xE0y \xE2m
      thanh s\xE1t xu\u1ED1ng s\xE0n nh\xE0 h\u01A1n. Ch\xFAng t\xF4i nh\xECn nhau
      trong b\xF3ng t\u1ED1i. Ch\u1EB3ng ai n\xF3i m\u1ED9t l\u1EDDi. Sau m\u1ED9t
      ti\u1EBFng \u0111\u1ED3ng h\u1ED3, ti\u1EBFng c\xE0o m\u1EDBi d\u1EE9t. S\xE1ng
      nay, ch\xFAng t\xF4i t\u1EEB c\u1EEDa s\u1ED5 ng\xF3 ra \u0111\u1EC3 ki\u1EC3m
      tra ph\xEDa c\u1EEDa ph\xF2ng \u2014 ch\u1EB3ng nh\xECn th\u1EA5y g\xEC c\u1EA3.
      Nh\u01B0ng c\xE1i m\xF9i. Gi\u1EDD \u0111\xE2y c\xF3 m\u1ED9t c\xE1i m\xF9i
      kinh kh\u1EE7ng xu\u1EA5t hi\u1EC7n. Ng\xF2n ng\u1ECDt. Th\u1ED1i r\u1EEFa.
      R\u1EA5t d\u1ECB h\u1EE3m. N\xF3 b\u1ED1c l\xEAn t\u1EEB ph\xEDa h\xE0nh lang.
      Ch\xFAng t\xF4i s\u1EBD kh\xF4ng m\u1EDF c\u1EEDa n\u1EEFa. D\xF9 c\xF3 chuy\u1EC7n
      g\xEC \u0111i ch\u0103ng n\u1EEFa c\u0169ng tuy\u1EC7t \u0111\u1ED1i kh\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16943457598652416
    m_Localized: "S\xE1ng nay khi ch\xFAng t\xF4i v\u1EEBa th\u1EE9c d\u1EADy, c\xF3
      \u0111\u1EE9a ch\u1EE3t th\u1ED1t l\xEAn: \"H\xF4m qua l\xE0 ng\xE0y Valentine
      \u0111\u1EA5y.\" C\u1EA3 l\u0169 b\u1ED7ng l\u1EB7ng \u0111i. Ch\u1EB3ng m\u1ED9t
      ai trong ch\xFAng t\xF4i nh\u1EDB c\u1EA3. Kh\xF4ng m\u1ED9t ng\u01B0\u1EDDi
      duy nh\u1EA5t. N\u1EBFu l\xE0 m\u1ED9t n\u0103m tr\u01B0\u1EDBc, ch\u1EAFc
      ch\xFAng t\xF4i \u0111\xE3 th\u1EA5y ph\xE1t b\u1EF1c v\xEC c\xE1c c\u1EB7p
      \u0111\xF4i b\u1EE7a v\xE2y kh\u1EAFp n\u01A1i, nh\u1EEFng b\xE0i \u0111\u0103ng
      tr\xE0n ng\u1EADp tr\xEAn m\u1EA1ng x\xE3 h\u1ED9i, r\u1ED3i c\u1EA3 s\xF4-c\xF4-la
      gi\u1EA3m gi\xE1 n\u1EEFa. C\xF2n b\xE2y gi\u1EDD \xE1? L\u0169 zombie th\xEC
      th\xE8m b\u1EADn t\xE2m \u0111\u1EBFn ng\xE0y Valentine. V\xE0 ch\xFAng t\xF4i
      c\u0169ng th\u1EBF. Tr\xE1i tim duy nh\u1EA5t m\xE0 ch\xFAng t\xF4i ph\u1EA3i
      lo l\u1EAFng l\xFAc n\xE0y l\xE0 c\xE1i \u0111ang \u0111\u1EADp th\xECnh th\u1ECBch
      trong l\u1ED3ng ng\u1EF1c m\xECnh \u0111\xE2y n\xE0y. M\u1EA5y con v\u1ECBt
      ngo\xE0i kia c\xF3 khi c\xF2n c\xF3 m\u1ED9t ng\xE0y Valentine ra tr\xF2 h\u01A1n
      ch\xFAng t\xF4i. \xCDt nh\u1EA5t th\xEC t\u1EE5i n\xF3 v\u1EABn c\xF2n c\xF3
      nhau. C\xF2n ch\xFAng t\xF4i th\xEC ch\u1EC9 c\xF3 m\u1EA5y phong l\u01B0\u01A1ng
      kh\xF4 v\xE0 m\u1ED9t c\xE1nh c\u1EEDa kh\xF3a ch\u1EB7t. Ch\xFAc m\u1EEBng
      ng\xE0y Valentine mu\u1ED9n nh\xE9. Hy v\u1ECDng ng\xE0y c\u1EE7a b\u1EA1n
      kh\xE1 kh\u1EA9m h\u01A1n. C\xF2n v\u1EDBi ch\xFAng t\xF4i, \u0111\xF3 c\u0169ng
      ch\u1EC9 l\xE0 m\u1ED9t ng\xE0y b\xECnh th\u01B0\u1EDDng kh\xE1c trong chu\u1ED7i
      ng\xE0y c\u1ED1 g\u1EAFng \u0111\u1EC3 kh\xF4ng ph\u1EA3i ch\u1EBFt m\xE0 th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 16943820917653504
    m_Localized: "Kh\xF4ng kh\xED h\xF4m nay c\u1EA3m gi\xE1c th\u1EADt kh\xE1c l\u1EA1.
      N\xF3 \u0111\u1EB7c h\u01A1n. N\u1EB7ng n\u1EC1 h\u01A1n. Ch\xFAng t\xF4i c\u0169ng
      ch\u1EB3ng r\xF5 \u0111\xE2y l\xE0 do c\u1EA3 l\u0169 t\u1EF1 suy di\u1EC5n
      hay l\xE0 s\u1EF1 th\u1EADt n\u1EEFa. M\u1ED9t v\xE0i ng\u01B0\u1EDDi tr\xEAn
      m\u1EA1ng x\xE3 h\u1ED9i \u0111ang r\u1EC9 tai nhau r\u1EB1ng b\u1ECDn zombie
      gi\u1EDD \u0111\xE3 c\xF3 \u0111\u1ED9c. R\u1EB1ng kh\xF4ng kh\xED xung quanh
      t\u1EE5i n\xF3 r\u1EA5t t\u1ED3i t\u1EC7. R\u1EB1ng tuy\u1EC7t \u0111\u1ED1i
      kh\xF4ng \u0111\u01B0\u1EE3c l\u1EA1i g\u1EA7n. Kh\xF4ng ch\u1EC9 v\xEC t\u1EE5i
      n\xF3 s\u1EBD c\u1EAFn b\u1EA1n \u2014 m\xE0 ch\u1EC9 c\u1EA7n h\xEDt th\u1EDF
      g\u1EA7n t\u1EE5i n\xF3 th\xF4i l\xE0 qu\xE1 \u0111\u1EE7 \u0111\u1EC3 r\u01B0\u1EDBc
      h\u1ECDa v\xE0o th\xE2n r\u1ED3i. Ch\xFAng t\xF4i ch\u1EB3ng bi\u1EBFt th\u1EF1c
      h\u01B0 th\u1EBF n\xE0o. Nh\u01B0ng d\xF9 sao th\xEC c\u1EA3 l\u0169 c\u0169ng
      \u0111\xE3 \u0111\xF3ng ch\u1EB7t c\u1EEDa s\u1ED5 l\u1EA1i. R\u1ED3i d\xF9ng
      b\u1EA5t c\u1EE9 th\u1EE9 g\xEC t\xECm \u0111\u01B0\u1EE3c \u0111\u1EC3 d\xE1n
      k\xEDn c\xE1c khe h\u1EDF. B\u0103ng keo v\u1EA3i. Qu\u1EA7n \xE1o c\u0169.
      Th\u1EADm ch\xED l\xE0 x\xE9 lu\xF4n c\u1EA3 t\u1EA5m \xE1p ph\xEDch tr\xEAn
      t\u01B0\u1EDDng. Gi\u1EDD \u0111\xE2y, c\u0103n ph\xF2ng s\u1EB7c s\u1EE5a
      m\xF9i m\u1ED3 h\xF4i v\xE0 n\u1ED7i s\u1EE3 h\xE3i. Nh\u01B0ng th\xE0 th\u1EBF
      c\xF2n h\u01A1n l\xE0 ph\u1EA3i ng\u1EEDi c\xE1i m\xF9i ch\u1EBFt ch\xF3c ngo\xE0i
      kia. Ph\xEDa b\xEAn ngo\xE0i, l\u0169 v\u1ECBt v\u1EABn ho\xE0n to\xE0n b\xECnh
      an v\xF4 s\u1EF1. D\u0129 nhi\xEAn r\u1ED3i, t\u1EE5i n\xF3 th\xEC l\xFAc n\xE0o
      ch\u1EB3ng v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 16944155614724096
    m_Localized: "M\u1ED9t tr\u1EADn b\xE3o nh\u1ECF \u0111\xE3 qu\xE9t qua v\xE0o
      \u0111\xEAm qua. Ti\u1EBFng m\u01B0a n\u1EC7n r\u1EA7m r\u1EA7m xu\u1ED1ng
      m\xE1i nh\xE0, ti\u1EBFng gi\xF3 r\xEDt qua t\u1EEBng khe h\u1EDF c\u1EE7a
      c\u1EEDa s\u1ED5. \u0110\xE3 l\xE2u r\u1ED3i ch\xFAng t\xF4i kh\xF4ng nh\xECn
      th\u1EA5y m\u1EA5y con m\xE8o. Kh\xF4ng th\u1EA5y con m\u01B0\u1EDBp cam b\xE9o
      \xFA, c\u0169ng ch\u1EB3ng th\u1EA5y nh\u1EEFng con kh\xE1c. T\u1EE5i n\xF3
      kh\xF4ng c\xF3 tr\xEAn m\xE1i nh\xE0 c\u0103n tin. C\u0169ng kh\xF4ng tr\u1ED1n
      d\u01B0\u1EDBi nh\u1EEFng t\xE1n c\xE2y. Ch\u1EB3ng \u1EDF b\u1EA5t c\u1EE9
      n\u01A1i n\xE0o trong t\u1EA7m m\u1EAFt c\u1EE7a ch\xFAng t\xF4i. C\xF3 th\u1EC3
      t\u1EE5i n\xF3 \u0111\xE3 t\xECm \u0111\u01B0\u1EE3c n\u01A1i tr\xFA \u1EA9n
      an to\xE0n. M\xE0 c\u0169ng c\xF3 th\u1EC3 l\xE0 kh\xF4ng. Tr\u1EADn b\xE3o
      tan v\xE0o bu\u1ED5i s\xE1ng, \u0111\u1EC3 l\u1EA1i m\u1ECDi th\u1EE9 \u01B0\u1EDBt
      s\u0169ng v\xE0 x\xE1m x\u1ECBt. Nh\u01B0ng l\u0169 v\u1ECBt th\xEC \u0111\xE3
      quay tr\u1EDF l\u1EA1i r\u1ED3i. T\u1EE5i n\xF3 r\u0169 l\xF4ng cho b\u1EAFn
      n\u01B0\u1EDBc tung t\xF3e nh\u01B0 th\u1EC3 ch\u01B0a t\u1EEBng c\xF3 chuy\u1EC7n
      g\xEC x\u1EA3y ra. Ch\xFAng t\xF4i v\u1EABn ti\u1EBFp t\u1EE5c \u0111\u1EA3o
      m\u1EAFt t\xECm ki\u1EBFm m\u1EA5y con m\xE8o. V\u1EABn b\u1EB7t v\xF4 \xE2m
      t\xEDn. C\u1EA3 l\u0169 c\u1EE9 gi\u1EA3 v\u1EDD nh\u01B0 vi\u1EC7c n\xE0y
      ch\u1EB3ng c\xF3 g\xEC \u0111\xE1ng \u0111\u1EC3 b\u1EADn t\xE2m. Nh\u01B0ng
      th\u1EF1c ra, \u0111\u1EE9a n\xE0o c\u0169ng lo s\u1ED1t v\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 16944381268279296
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i b\u1EAFt \u0111\u1EA7u b\xE0n v\u1EC1
      \u0111\u1ED3 \u0103n. Kh\xF4ng ph\u1EA3i m\u1EA5y phong l\u01B0\u01A1ng kh\xF4
      m\xE0 c\u1EA3 l\u0169 \u0111\xE3 ph\u1EA3i g\u1EB7m su\u1ED1t g\u1EA7n ba tu\u1EA7n
      qua. M\xE0 l\xE0 \u0111\u1ED3 \u0103n th\u1EF1c s\u1EF1 c\u01A1. C\xF3 \u0111\u1EE9a
      nh\u1EAFc \u0111\u1EBFn ph\u1EDF. C\xE1i m\xF9i n\u01B0\u1EDBc d\xF9ng nghi
      ng\xFAt kh\xF3i v\xE0o m\u1ED7i bu\u1ED5i s\xE1ng, mi\u1EBFng chanh v\u1EAFt
      k\xE8m, r\u1ED3i c\u1EA3 ch\xFAt sa t\u1EBF n\u1ED5i b\u1ED3ng b\u1EC1nh b\xEAn
      tr\xEAn. \u0110\u1EE9a kh\xE1c l\u1EA1i n\xF3i \u0111\u1EBFn b\xE1nh m\xEC
      \u2014 l\u1EDBp v\u1ECF gi\xF2n r\u1EE5m, v\u1ECB b\xE9o c\u1EE7a pa-t\xEA,
      v\xE0 c\xE1i c\u1EA3m gi\xE1c s\u01B0\u1EDBng r\u01A1n khi c\u1EAFn tr\xFAng
      m\u1ED9t mi\u1EBFng th\u1ECBt x\xE1 x\xEDu gi\u1EA5u b\xEAn trong. M\u1ED9t
      \u0111\u1EE9a n\u1EEFa th\xEC ch\u1EC9 th\xEC th\u1EA7m \u0111\xFAng hai t\u1EEB
      \"c\u01A1m rang\". C\u1EA3 l\u0169 l\u1EA1i l\u1EB7ng \u0111i. Ch\xFAng t\xF4i
      t\u1EEBng m\u1EDF m\u1ED3m ra l\xE0 ch\xEA bai \u0111\u1ED3 \u0103n c\u0103ng-tin.
      N\xE0o l\xE0 qu\xE1 nhi\u1EC1u d\u1EA7u m\u1EE1. N\xE0o l\xE0 nh\u1EA1t nh\u1EBDo.
      Ng\xE0y n\xE0o c\u0169ng l\u1EB7p \u0111i l\u1EB7p l\u1EA1i m\u1ED9t th\u1EF1c
      \u0111\u01A1n. C\xF2n b\xE2y gi\u1EDD \xE1? Cho ch\xFAng t\xF4i m\u1ED9t \u0111\u0129a
      c\u01A1m rang t\u1EC7 h\u1EA1i \u0111\xF3 th\xF4i th\xEC b\u1EA3o l\xE0m g\xEC
      ch\xFAng t\xF4i c\u0169ng d\xE1m l\xE0m. Ch\xFAng t\xF4i th\xE8m kh\xE1t b\u1EA5t
      c\u1EE9 th\u1EE9 g\xEC kh\xF4ng b\u1ECB kh\xF4 kh\u1ED1c v\xE0 b\u1ECDc trong
      m\u1EA5y l\u1EDBp nilon. M\u1EA5y con v\u1ECBt ngo\xE0i kia \u0111ang r\u1EC9a
      giun m\xE0 \u0103n k\xECa. \u0110\u1EBFn c\u1EA3 t\u1EE5i n\xF3 b\xE2y gi\u1EDD
      \u0103n u\u1ED1ng c\xF2n ra d\xE1ng con ng\u01B0\u1EDDi h\u01A1n c\u1EA3 ch\xFAng
      t\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 16944646780305408
    m_Localized: "S\u1EF1 tuy\u1EC7t v\u1ECDng \u0111ang d\u1EA7n len l\u1ECFi v\xE0o
      n\u01A1i n\xE0y. Ch\xFAng t\xF4i kh\xF4ng ai b\u1EA3o ai, nh\u01B0ng \u0111\u1EE9a
      n\xE0o c\u0169ng t\u1EF1 c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c. \u0110\xEAm
      qua, c\xF3 \u0111\u1EE9a b\u1EAFt \u0111\u1EA7u ng\xE2n nga m\u1ED9t b\xE0i
      h\xE1t. Ch\xFAng t\xF4i ch\u1EB3ng nh\u1EDB n\u1ED5i l\u1EDDi. Ch\u1EC9 nh\u1EDB
      m\u1ED7i giai \u0111i\u1EC7u. \u0110\xF3 l\xE0 m\u1ED9t b\xE0i g\xEC \u0111\xF3
      c\u1EE7a m\u1ED9t ca s\u0129 m\xE0 ch\xFAng t\xF4i t\u1EEBng hay nghe tr\u01B0\u1EDBc
      khi m\u1ECDi chuy\u1EC7n \u1EADp \u0111\u1EBFn. \u0110\u1EBFn c\u1EA3 c\xE1i
      t\xEAn c\u1EE7a h\u1ECD ch\xFAng t\xF4i c\u0169ng ch\u1ECBu ch\u1EBFt kh\xF4ng
      nh\u1EDB n\u1ED5i. Ch\u1EC9 nh\u1EDB mang m\xE1ng gi\u1ECDng h\xE1t. Ch\u1EC9
      nh\u1EDB l\u1EA1i c\u1EA3m gi\xE1c l\xFAc b\u1EA5y gi\u1EDD. Ngh\u0129 m\xE0
      xem ch\xFAng t\xF4i \u0111\xE3 \u0111\xE1nh m\u1EA5t ch\xEDnh m\xECnh \u0111\u1EBFn
      nh\u01B0\u1EDDng n\xE0o r\u1ED3i. \u0110\u1ED1i di\u1EC7n v\u1EDBi ch\xFAng
      t\xF4i, t\xF2a nh\xE0 k\xFD t\xFAc x\xE1 b\xEAn kia v\u1EABn im l\xECm nh\u01B0
      t\u1EDD. R\xE8m c\u1EEDa \u0111\xF3ng k\xEDn m\xEDt. Kh\xF4ng c\xF3 m\u1ED9t
      s\u1EF1 chuy\u1EC3n \u0111\u1ED9ng. Kh\xF4ng m\u1ED9t \xE1nh \u0111\xE8n. M\u1ECDi
      th\u1EE9 qu\xE1 \u0111\u1ED7i t\u0129nh l\u1EB7ng. C\xE1i ki\u1EC3u im \u1EAFng
      th\u01B0\u1EDDng xu\u1EA5t hi\u1EC7n ngay tr\u01B0\u1EDBc khi m\u1ED9t \u0111i\u1EC1u
      g\xEC \u0111\xF3 \u0111\u1ED5 v\u1EE1. Ch\xFAng t\xF4i c\u1EE9 nh\xECn ch\u1EB1m
      ch\u1EB1m v\xE0o nh\u1EEFng khung c\u1EEDa s\u1ED5 t\u1ED1i om \u1EA5y, m\xF2n
      m\u1ECFi ch\u1EDD \u0111\u1EE3i m\u1ED9t t\xEDn hi\u1EC7u. B\u1EA5t c\u1EE9
      t\xEDn hi\u1EC7u n\xE0o c\u0169ng \u0111\u01B0\u1EE3c. Nh\u01B0ng v\u1EABn
      ch\u1EB3ng c\xF3 g\xEC. C\xF3 l\u1EBD ch\xEDnh s\u1EF1 tr\u1ED1ng r\u1ED7ng
      \u0111\xF3 l\u1EA1i l\xE0 m\u1ED9t l\u1EDDi h\u1ED3i \u0111\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 16947266936848384
    m_Localized: "Cu\u1ED1i c\xF9ng th\xEC ch\xFAng t\xF4i c\u0169ng ph\u1EA3i l\xE0m
      c\xE1i vi\u1EC7c \u0111\xF3. M\u1EDF c\u1EEDa ph\xF2ng. Kh\xF4ng ph\u1EA3i
      m\u1EDF ra ph\xEDa h\xE0nh lang \u2014 m\xE0 ch\u1EC9 l\xE0 khu v\u1EF1c sinh
      ho\u1EA1t chung n\u1EB1m gi\u1EEFa ph\xF2ng ch\xFAng t\xF4i v\xE0 ph\xF2ng
      \u0111\u1ED1i di\u1EC7n th\xF4i. Ph\xF2ng c\u1EE7a ch\xFAng t\xF4i n\u1EB1m
      \u1EDF ph\xEDa b\xEAn tr\xE1i. M\u1ED7i b\xEAn \u0111\u1EC1u c\xF3 ph\xF2ng
      v\u1EC7 sinh ri\xEAng bi\u1EC7t, kh\xF4ng d\xF9ng chung. Nh\u01B0ng v\xEC n\u01B0\u1EDBc
      b\xEAn ph\xF2ng m\xECnh s\u1EAFp c\u1EA1n s\u1EA1ch n\xEAn ch\xFAng t\xF4i
      mu\u1ED1n sang ki\u1EC3m tra th\u1EED. Bi\u1EBFt \u0111\xE2u \xE1p l\u1EF1c
      n\u01B0\u1EDBc b\xEAn ph\xEDa kia v\u1EABn c\xF2n. Bi\u1EBFt \u0111\xE2u ch\xFAng
      t\xF4i c\xF3 th\u1EC3 h\u1EE9ng th\xEAm m\u1ED9t \xEDt \u0111\u1EC3 t\xEDch
      tr\u1EEF cho sau n\xE0y. Ch\xFAng t\xF4i m\u1EDF c\u1EEDa th\u1EADt ch\u1EADm.
      N\xF3 k\xEAu k\xF3t k\xE9t m\u1ED9t ti\u1EBFng. C\u1EA3 l\u0169 n\xEDn th\u1EDF
      nghe ng\xF3ng. Kh\xF4ng c\xF3 \u0111\u1ED9ng t\u0129nh g\xEC. Ch\xFAng t\xF4i
      b\u01B0\u1EDBc v\u1EC1 ph\xEDa ph\xF2ng v\u1EC7 sinh b\xEAn kia, v\u1EB7n v\xF2i
      n\u01B0\u1EDBc. Ch\u1EC9 c\xF3 m\u1ED9t ti\u1EBFng ho s\u1EB7c s\u1EE5a \u0111\u1EA7y
      b\u1EA5t l\u1EF1c. V\xF2i n\u01B0\u1EDBc phun ra v\xE0i tia y\u1EBFu \u1EDBt
      r\u1ED3i t\u1ECBt h\u1EB3n. B\xEAn n\xE0y c\u0169ng m\u1EA5t n\u01B0\u1EDBc
      r\u1ED3i. Ch\xFAng t\xF4i \u0111\u1EE9ng th\u1EABn th\u1EDD \u1EDF \u0111\xF3
      m\u1ED9t l\xFAc, nh\xECn ch\u1EB1m ch\u1EB1m v\xE0o c\xE1i \u0111\u01B0\u1EDDng
      \u1ED1ng kh\xF4 kh\u1ED1c nh\u01B0 th\u1EC3 n\xF3 \u0111ang n\u1EE3 ch\xFAng
      t\xF4i m\u1ED9t l\u1EDDi xin l\u1ED7i v\u1EADy. \xCDt nh\u1EA5t th\xEC \u0111i\u1EC7n
      v\u1EABn ch\u01B0a m\u1EA5t. \u0110\xFAng l\xE0 m\u1ED9t ch\xFAt \u0111\u1EB7c
      \xE2n nh\u1ECF nhoi. V\xE0 r\u1ED3i ch\xFAng t\xF4i nghe th\u1EA5y n\xF3. Ti\u1EBFng
      th\xEC th\u1EA7m. Ph\xE1t ra t\u1EEB c\u0103n ph\xF2ng ngay s\xE1t v\xE1ch
      \u2014 ph\xEDa b\xEAn kia c\u1EE7a khu sinh ho\u1EA1t chung. R\u1EA5t kh\u1EBD.
      R\u1EA5t nhanh. Nghe c\u1EE9 nh\u01B0 hai ng\u01B0\u1EDDi \u0111ang tranh c\xE3i
      v\u1EDBi nhau nh\u01B0ng c\u1ED1 kh\xF4ng ph\xE1t ra th\xE0nh l\u1EDDi. Ch\xFAng
      t\xF4i g\xF5 c\u1EEDa. Th\u1EADt kh\u1EBD kh\xE0ng. Kh\xF4ng c\xF3 ti\u1EBFng
      \u0111\xE1p l\u1EA1i. Ti\u1EBFng th\xEC th\u1EA7m b\u1ED7ng t\u1EAFt l\u1ECBm.
      Ch\xFAng t\xF4i g\xF5 th\xEAm l\u1EA7n n\u1EEFa. V\u1EABn l\xE0 m\u1ED9t kho\u1EA3ng
      kh\xF4ng v\xF4 v\u1ECDng. Ch\u1EC9 c\xF3 s\u1EF1 im l\u1EB7ng. Ch\xFAng t\xF4i
      \u0111\xE0nh quay v\u1EC1 ph\xF2ng m\xECnh v\xE0 kh\xF3a ch\u1EB7t c\u1EEDa
      l\u1EA1i. Ch\u1EAFc l\xE0 do c\u1EA3 l\u0169 t\u1EF1 t\u01B0\u1EDFng t\u01B0\u1EE3ng
      ra th\xF4i. Ch\u1EAFc th\u1EBF. Nh\u01B0ng d\xF9 sao th\xEC \u0111\xEAm \u0111\xF3
      ch\xFAng t\xF4i c\u0169ng ch\u1EB3ng th\u1EC3 n\xE0o ng\u1EE7 ngon n\u1ED5i."
    m_Metadata:
      m_Items: []
  - m_Id: 16948312274845696
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i ng\u1ED3i l\u1EB7ng thinh b\xEAn nhau.
      Ch\u1EB3ng v\xEC l\xFD do g\xEC c\u1EA3. Ch\u1EC9 l\xE0 c\u1EA3m th\u1EA5y
      c\xF5i l\xF2ng n\u1EB7ng tr\u0129u. C\xF3 \u0111\u1EE9a l\xEAn ti\u1EBFng:
      \"\u01AF\u1EDBc g\xEC tao \u0111\xE3 h\u1ECDc c\xE1ch sinh t\u1ED3n.\" Kh\xF4ng
      ph\u1EA3i l\xE0 ch\u1EA1y tr\u1ED1n kh\u1ECFi l\u0169 zombie \u2014 c\xE1i
      kho\u1EA3n \u0111\xF3 th\xEC c\u1EA3 l\u0169 t\u1EF1 m\xF2 m\u1EABm ra \u0111\u01B0\u1EE3c
      r\u1ED3i. M\xE0 l\xE0 k\u1EF9 n\u0103ng sinh t\u1ED3n th\u1EF1c s\u1EF1 c\u01A1.
      T\xECm ngu\u1ED3n n\u01B0\u1EDBc. Nh\xF3m l\u1EEDa. Nh\u1EADn bi\u1EBFt xem
      lo\u1EA1i c\xE2y n\xE0o an to\xE0n \u0111\u1EC3 \u0103n \u0111\u01B0\u1EE3c.
      Ch\xFAng t\xF4i t\u1EEBng l\u01B0\u1EDBt xem kh\xF4ng bi\u1EBFt bao nhi\xEAu
      video sinh t\u1ED3n tr\xEAn m\u1EA1ng x\xE3 h\u1ED9i. Nh\xECn ng\u01B0\u1EDDi
      ta d\u1EF1ng l\u1EC1u tr\xFA \u1EA9n trong r\u1EEBng s\xE2u m\xE0 tr\xEAn tay
      ch\u1EB3ng c\xF3 g\xEC ngo\xE0i m\u1ED9t con dao v\xE0 s\u1EF1 t\u1EF1 tin.
      L\xFAc \u0111\xF3 ch\u1EC9 ngh\u0129 b\u1EE5ng tr\xF4ng ng\u1EA7u \u0111\xE9t.
      Ch\u01B0a bao gi\u1EDD ngh\u0129 c\xF3 ng\xE0y m\xECnh l\u1EA1i c\u1EA7n \u0111\u1EBFn
      n\xF3. Gi\u1EDD th\xEC ch\xFAng t\xF4i \u1EDF \u0111\xE2y. Ng\xE0y th\u1EE9
      21. \u0110\u01B0\u1EDDng \u1ED1ng kh\xF4ng c\xF3 m\u1ED9t gi\u1ECDt n\u01B0\u1EDBc.
      \u0110\u1ED3 \u0103n ch\u1EB3ng c\xF3 g\xEC ngo\xE0i l\u01B0\u01A1ng kh\xF4.
      K\u1EF9 n\u0103ng th\xEC ch\u1EB3ng c\xF3 g\xEC ngo\xE0i tr\u1ED1n v\xE0 \u0111\u1EE3i.
      N\u1EF1c c\u01B0\u1EDDi th\u1EADt, c\xE1i m\u1EA1ng Internet lu\xF4n l\xE0m
      b\u1EA1n c\xF3 c\u1EA3m gi\xE1c m\xECnh \u0111\xE3 chu\u1EA9n b\u1ECB s\u1EB5n
      s\xE0ng cho m\u1ECDi th\u1EE9 tr\xEAn \u0111\u1EDDi. \u0110\u1EC3 r\u1ED3i
      khi th\u1EF1c t\u1EA1i \u1EADp \u0111\u1EBFn, b\u1EA1n m\u1EDBi nh\u1EADn ra
      m\xECnh ch\u1EB3ng bi\u1EBFt m\u1ED9t c\xE1i m\xF4 t\xEA g\xEC h\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 16949406677811200
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i \u0111\xE3 gom h\u1EBFt s\u1EF1 can
      \u0111\u1EA3m c\u1EE7a m\xECnh l\u1EA1i. B\u01B0\u1EDBc b\u0103ng qua ban c\xF4ng
      \u0111\u1EC3 ti\u1EBFn v\u1EC1 ph\xEDa c\u0103n ph\xF2ng b\xEAn c\u1EA1nh.
      Ph\xF2ng c\u1EE7a ch\xFAng t\xF4i v\xE0 ph\xF2ng \u0111\xF3 d\xF9ng chung m\u1ED9t
      ban c\xF4ng \u2014 chia l\xE0m hai b\xEAn tr\xE1i ph\u1EA3i. Ch\u1EB3ng c\u1EA7n
      ph\u1EA3i leo tr\xE8o g\xEC c\u1EA3. Ch\u1EC9 v\xE0i b\u01B0\u1EDBc ch\xE2n
      l\xE0 t\u1EDBi. Khung c\u1EEDa s\u1ED5 t\u1ED1i om. R\xE8m c\u1EEDa b\u1ECB
      k\xE9o ch\u1EB7t m\xEDt. C\xF3 th\u1EE9 g\xEC \u0111\xF3 \u0111ang ch\xE8n
      c\u1EE9ng v\xE0o t\u1EA5m r\xE8m \u2014 v\xE0 c\u1EA3 ph\xEDa c\u1EEDa ra v\xE0o
      n\u1EEFa. Ng\xE1ng \u0111\u01B0\u1EDDng ho\xE0n to\xE0n. Kh\xF4ng c\xF3 c\xE1ch
      n\xE0o v\xE0o \u0111\u01B0\u1EE3c. Nh\u01B0ng ch\xFAng t\xF4i nghe th\u1EA5y
      c\xF3 ai \u0111\xF3 \u1EDF b\xEAn trong. M\u1ED9t ti\u1EBFng s\u1ED9t so\u1EA1t
      r\u1EA5t kh\u1EBD. M\u1ED9t ti\u1EBFng th\u1EDF. C\xF3 l\u1EBD v\u1EADy. Ch\xFAng
      t\xF4i g\u1ECDi v\u1EDBi v\xE0o. Th\u1EF1c ra ch\u1EC9 l\xE0 th\xEC th\u1EA7m
      th\xF4i. Kh\xF4ng c\xF3 ti\u1EBFng tr\u1EA3 l\u1EDDi. Ch\xFAng t\xF4i \u0111\xE0nh
      quay tr\u1EDF l\u1EA1i ph\xF2ng m\xECnh. C\u1EA3 l\u0169 t\u1EF1 tr\u1EA5n
      an b\u1EA3n th\xE2n: n\u1EBFu c\xF3 ai \u0111\xF3 c\xF2n s\u1ED1ng \u1EDF trong
      ph\xF2ng \u0111\xF3, \u0111\xE1ng l\u1EBD ch\xFAng t\xF4i \u0111\xE3 ch\u1EA1m
      m\u1EB7t nhau t\u1EEB l\xE2u r\u1ED3i. Hai m\u01B0\u01A1i hai ng\xE0y tr\u1EDDi.
      C\xF9ng m\u1ED9t t\u1EA7ng. C\xF9ng m\u1ED9t ban c\xF4ng. Nh\u1EEFng b\u1EE9c
      t\u01B0\u1EDDng v\xE1ch ng\u0103n th\xEC m\u1ECFng d\xEDnh. T\u1EE5i n\xF3
      \u0111\xE1ng l\u1EBD ph\u1EA3i g\xF5 c\u1EEDa. Ch\xFAng t\xF4i \u0111\xE1ng
      l\u1EBD ph\u1EA3i nghe th\u1EA5y. Nh\u01B0ng ngh\u0129 \u0111i th\xEC c\u0169ng
      ph\u1EA3i ngh\u0129 l\u1EA1i\u2026 bi\u1EBFt \u0111\xE2u h\u1ECD \u0111ang
      s\u1EE3 h\xE3i. M\xE0 ch\xEDnh ch\xFAng t\xF4i c\u0169ng th\u1EBF th\xF4i.
      Li\u1EC7u vi\u1EC7c t\xECm th\u1EA5y m\u1ED9t con ng\u01B0\u1EDDi kh\xE1c v\xE0o
      l\xFAc n\xE0y c\xF3 c\xF2n l\xE0 m\u1ED9t \u0111i\u1EC1u t\u1ED1t l\xE0nh n\u1EEFa
      kh\xF4ng? Hay \u0111\xF3 c\u0169ng ch\u1EC9 l\xE0 m\u1ED9t th\u1EE9 n\u1EEFa
      \u0111\u1EC3 ch\xFAng t\xF4i ph\u1EA3i n\u1EBFm tr\u1EA3i c\u1EA3m gi\xE1c
      m\u1EA5t m\xE1t?"
    m_Metadata:
      m_Items: []
  - m_Id: 16950869101592576
    m_Localized: "B\u1EA7u tr\u1EDDi h\xF4m nay xanh ng\u1EAFt m\u1ED9t m\xE0u. \u0110\u1EB9p
      \u0111\u1EBD. V\xE0 t\xE0n nh\u1EABn. Ch\xFAng t\xF4i n\u1EB1m d\xE0i tr\xEAn
      s\xE0n nh\xE0, ch\u0103m ch\u0103m nh\xECn l\xEAn b\u1EA7u tr\u1EDDi qua khung
      c\u1EEDa s\u1ED5. V\xE0o m\u1ED9t ng\xE0y nh\u01B0 th\u1EBF n\xE0y c\u1EE7a
      nh\u1EEFng ng\xE0y x\u01B0a c\u0169, khi m\u1ECDi th\u1EE9 v\u1EABn c\xF2n
      b\xECnh th\u01B0\u1EDDng, c\u1EA3 l\u0169 ch\u1EAFc \u0111ang t\u1EE5 t\u1EADp
      \u1EDF trong ph\xF2ng \u0111\u1EC3 c\xE0y game. L\xE0m v\xE0i tr\u1EADn g\xEC
      \u0111\xF3 vui vui. R\u1ED3i sau \u0111\xF3 s\u1EBD n\u1EA5u m\xEC cay. \u0102n
      cho \u0111\u1EBFn khi b\u1EE5ng d\u1EA1 n\xF3ng c\u1ED3n c\xE0o l\xEAn m\u1EDBi
      th\xF4i. R\u1ED3i l\u1EA1i ng\u1ED3i c\u01B0\u1EDDi r\xFAc r\xEDch v\xEC nh\u1EEFng
      chuy\u1EC7n kh\xF4ng \u0111\xE2u. C\xF2n b\xE2y gi\u1EDD, ch\xFAng t\xF4i ch\u1EC9
      n\u1EB1m tr\u01A1 ra \u0111\xE2y. V\u1EABn b\u1EA7u tr\u1EDDi \u0111\xF3. V\u1EABn
      \xE1nh n\u1EAFng \u0111\xF3. V\u1EABn l\xE0 ch\xFAng t\xF4i. Nh\u01B0ng \u0111\xE3
      kh\xE1c r\u1ED3i. M\u1ECDi th\u1EE9 \u0111\xE3 ho\xE0n to\xE0n kh\xE1c x\u01B0a.
      L\u0169 chim v\u1EABn bay l\u01B0\u1EE3n tr\xEAn cao. Nh\u1EEFng \u0111\xE1m
      m\xE2y v\u1EABn kh\xF4ng ng\u1EEBng tr\xF4i. Th\u1EBF gi\u1EDBi n\xE0y ch\u1EB3ng
      h\u1EC1 d\u1EEBng l\u1EA1i. Ch\u1EC9 c\xF3 ch\xFAng t\xF4i l\xE0 d\u1EEBng
      l\u1EA1i m\xE0 th\xF4i. Ch\xFAng t\xF4i ng\u01B0\u1EDBc nh\xECn l\xEAn v\xE0
      b\u1ED7ng qu\xEAn m\u1EA5t trong m\u1ED9t gi\xE2y ng\u1EAFn ng\u1EE7i r\u1EB1ng
      ngo\xE0i s\xE2n tr\u01B0\u1EDDng kia \u0111ang ng\u1EADp tr\xE0n v\u1EBFt m\xE1u.
      \u0110\u1EC3 r\u1ED3i sau \u0111\xF3 l\u1EA1i s\u1EF1c nh\u1EDB ra. Nh\u01B0ng
      d\xF9 th\u1EBF, c\u1EA3 l\u0169 v\u1EABn c\u1EE9 ti\u1EBFp t\u1EE5c nh\xECn
      ch\u1EB1m ch\u1EB1m v\xE0o b\u1EA7u tr\u1EDDi. V\xEC ngo\xE0i vi\u1EC7c \u0111\xF3
      ra, ch\xFAng t\xF4i ch\u1EB3ng c\xF2n bi\u1EBFt ph\u1EA3i l\xE0m g\xEC n\u1EEFa
      c\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 16951945443885056
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i l\u1EA1i l\xEAn m\u1EA1ng x\xE3 h\u1ED9i.
      Ch\u1EC9 l\xE0 \u0111\u1EC3 gi\u1EBFt th\u1EDDi gian. \u0110\u1EC3 c\u1EA3m
      th\u1EA5y b\u1EDBt c\xF4 \u0111\u01A1n h\u01A1n ph\u1EA7n n\xE0o. Tr\xEAn \u0111\xF3
      \u0111ang r\u1EA7m r\u1ED9 m\u1ED9t tr\xE0o l\u01B0u m\u1EDBi \u2014 m\u1ECDi
      ng\u01B0\u1EDDi t\u1EF1 quay c\u1EA3nh ch\xEDnh m\xECnh \u0111ang th\xE1o ch\u1EA1y
      kh\u1ECFi l\u0169 zombie. Tr\xF4ng ch\u1EB3ng kh\xE1c g\xEC m\u1ED9t th\u1EED
      th\xE1ch. \"Th\xEDch nghi hay l\xE0 ch\u1EBFt,\" h\u1ECD n\xF3i v\u1EADy. Ch\u1EA1y
      th\u1EADt nhanh. Quay video l\u1EA1i. R\u1ED3i \u0111\u0103ng l\xEAn m\u1EA1ng.
      M\u1ED9t v\xE0i ng\u01B0\u1EDDi trong s\u1ED1 h\u1ECD ch\u1EA1y r\u1EA5t nhanh.
      M\u1ED9t v\xE0i ng\u01B0\u1EDDi th\xEC may m\u1EAFn. Nh\u01B0ng r\u1ED3i ch\xFAng
      t\xF4i b\u1EAFt \u0111\u1EA7u nh\u1EADn ra m\u1ED9t \u0111i\u1EC1u k\u1EF3
      l\u1EA1. Nh\u1EEFng ng\u01B0\u1EDDi t\u1EEBng \u0111\u0103ng video v\xE0o tu\u1EA7n
      tr\u01B0\u1EDBc \u1EA5y h\u1EA3? Gi\u1EDD t\xE0i kho\u1EA3n c\u1EE7a h\u1ECD
      \u0111\xE3 t\u1EAFt \u0111\xE8n h\u1EBFt r\u1ED3i. Kh\xF4ng s\xF3t m\u1ED9t
      ai. Ch\xFAng t\xF4i l\u1ED9i b\xE0i xem l\u1EA1i m\u1ED9t l\u1EA7n n\u1EEFa.
      B\u1EA5m t\u1EA1m d\u1EEBng. Ph\xF3ng to m\xE0n h\xECnh l\xEAn. M\u1ED9t v\u1EBFt
      c\xE0o \u1EDF ch\u1ED7 n\xE0y. M\u1ED9t v\u1EBFt c\u1EAFn \u1EDF ch\u1ED7 kia.
      Ch\xFAng b\u1ECB gi\u1EA5u nh\u1EB9m \u0111i sau nh\u1EEFng khung h\xECnh nh\xF2e
      nho\u1EB9t v\xEC chuy\u1EC3n \u0111\u1ED9ng nhanh. C\xF3 th\u1EC3 ch\xEDnh
      h\u1ECD c\u0169ng kh\xF4ng nh\u1EADn ra. Ho\u1EB7c c\xF3 th\u1EC3 h\u1ECD ch\u1EB3ng
      th\xE8m b\u1EADn t\xE2m n\u1EEFa r\u1ED3i. Tr\xE0o l\u01B0u \u0111\xF3 v\u1EABn
      c\u1EE9 ti\u1EBFp di\u1EC5n. M\u1ED7i ng\xE0y l\u1EA1i c\xF3 th\xEAm nh\u1EEFng
      g\u01B0\u01A1ng m\u1EB7t m\u1EDBi. V\u1EABn l\xE0 nh\u1EEFng v\u1EBFt c\xE0o
      c\u1EA5u \u0111\xF3. V\xE0 v\u1EABn l\xE0 s\u1EF1 im l\u1EB7ng \u0111\u1EBFn
      \u0111\xE1ng s\u1EE3 sau \u0111\xF3. Ch\xFAng t\xF4i t\u1EAFt \u1EE9ng d\u1EE5ng.
      Ch\u1EB3ng c\xF2n c\u1EA3m th\u1EA5y b\u1EDBt c\xF4 \u0111\u01A1n ch\xFAt n\xE0o
      n\u1EEFa r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 16964717477052416
    m_Localized: "H\xF4m nay qu\xE2n \u0111\u1ED9i \u0111\xE3 \u0111\u0103ng t\u1EA3i
      hai b\u1EA3n th\xF4ng b\xE1o. B\u1EA3n \u0111\u1EA7u ti\xEAn nghe c\xF3 v\u1EBB
      nh\u01B0 l\xE0 m\u1ED9t tin t\u1EE9c t\u1ED1t l\xE0nh: h\u1ECD \u0111\xE3 thi\u1EBFt
      l\u1EADp \u0111\u01B0\u1EE3c m\u1ED9t v\xF9ng an to\xE0n. B\u1EA5t k\u1EF3
      ai c\xF2n s\u1ED1ng s\xF3t n\xEAn t\xECm c\xE1ch di chuy\u1EC3n \u0111\u1EBFn
      \u0111\xF3. Nh\u01B0ng tin vui c\u0169ng ch\u1EC9 d\u1EEBng l\u1EA1i \u1EDF
      \u0111\xF3 m\xE0 th\xF4i. V\xF9ng an to\xE0n c\xE1ch \u0111\xE2y t\u1EADn 100
      c\xE2y s\u1ED1. Ch\xFAng t\xF4i kh\xF4ng c\xF3 \xF4 t\xF4. Ch\u1EB3ng c\xF3
      b\u1EA5t c\u1EE9 ph\u01B0\u01A1ng ti\u1EC7n g\xEC c\xF3 th\u1EC3 l\u0103n b\xE1nh
      \u0111\u01B0\u1EE3c. Cu\u1ED1c b\u1ED9 \u0111\u1ED3ng ngh\u0129a v\u1EDBi vi\u1EC7c
      ph\u1EA3i b\u0103ng qua nh\u1EEFng con ph\u1ED1 ch\u1EADt n\xEDch zombie. Kho\u1EA3ng
      c\xE1ch \u0111\xF3 th\xE0 b\u1EA3o ch\xFAng t\xF4i l\xEAn m\u1EB7t tr\u0103ng
      nghe c\xF2n th\u1EF1c t\u1EBF h\u01A1n. B\u1EA3n th\xF4ng b\xE1o th\u1EE9 hai
      c\xF2n t\u1ED3i t\u1EC7 h\u01A1n g\u1EA5p b\u1ED9i. H\u1ECD n\xF3i r\u1EB1ng
      h\u1EC7 th\u1ED1ng \u0111i\u1EC7n l\u01B0\u1EDBi c\xF3 th\u1EC3 s\u1EBD b\u1EAFt
      \u0111\u1EA7u s\u1EADp. Trong v\xF2ng n\u0103m ng\xE0y n\u1EEFa. Ho\u1EB7c
      c\xF3 khi c\xF2n s\u1EDBm h\u01A1n. Ch\xFAng t\xF4i c\u1EE9 tr\xE2n tr\xE2n
      nh\xECn v\xE0o m\xE0n h\xECnh su\u1ED1t m\u1ED9t h\u1ED3i l\xE2u. Kh\xF4ng
      m\u1ED9t ai m\u1EDF l\u1EDDi. M\u1ED9t tr\u0103m c\xE2y s\u1ED1. N\u0103m ng\xE0y
      s\u1EED d\u1EE5ng \u0111i\u1EC7n cu\u1ED1i c\xF9ng. Ch\xFAng t\xF4i s\u1EBD
      ch\u1EB3ng \u0111i \u0111\xE2u \u0111\u01B0\u1EE3c c\u1EA3. V\xE0 s\u1EDBm
      th\xF4i, ngay c\u1EA3 \xE1nh s\xE1ng ch\xFAng t\xF4i c\u0169ng s\u1EBD kh\xF4ng
      c\xF2n."
    m_Metadata:
      m_Items: []
  - m_Id: 16968342676914176
    m_Localized: "K\u1EC3 t\u1EEB sau th\xF4ng b\xE1o ng\xE0y h\xF4m qua, ch\xFAng
      t\xF4i b\u1EAFt \u0111\u1EA7u x\xE0i \u0111i\u1EC7n v\xF4 t\u1ED9i v\u1EA1
      nh\u01B0 th\u1EC3 t\u1EEB tr\u01B0\u1EDBc \u0111\u1EBFn nay ch\u01B0a t\u1EEBng
      bi\u1EBFt tr\xE2n tr\u1ECDng n\xF3 v\u1EADy. \u1EA4m si\xEAu t\u1ED1c b\u1EADt
      li\xEAn t\u1EE5c. M\xE1y t\xEDnh c\u1EAFm s\u1EA1c. \u0110i\u1EC7n tho\u1EA1i
      c\u1EAFm ngu\u1ED3n. M\u1ECDi \u1ED5 c\u1EAFm \u0111\u1EC1u ch\u1EADt k\xEDn.
      N\u1EBFu kh\xF4ng th\u1EC3 \u0111un s\xF4i n\u01B0\u1EDBc, ch\xFAng t\xF4i
      v\u1EABn c\xF3 th\u1EC3 g\u1EB7m l\u01B0\u01A1ng kh\xF4 \u2014 d\xF9 sao th\xEC
      t\u1EE5i n\xF3 kh\xF4 kh\u1ED1c c\u0169ng c\xF3 l\xFD do c\u1EA3. Nh\u01B0ng
      c\xF3 n\u01B0\u1EDBc \u1EA5m \u01B0? \u0110\u01B0\u1EE3c v\u1EADy th\xEC t\u1ED1t
      bi\u1EBFt m\u1EA5y. Ch\u1EC9 l\xE0 \u0111\u1EC3 c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c
      m\u1ED9t th\u1EE9 g\xEC \u0111\xF3 n\xF3ng h\u1ED5i ch\u1EA3y xu\xF4i xu\u1ED1ng
      c\u1ED5 h\u1ECDng. M\u1ED9t ch\xFAt an \u1EE7i \xEDt \u1ECFi. Ch\xFAng t\xF4i
      t\u1EEBng coi n\u01B0\u1EDBc n\xF3ng l\xE0 m\u1ED9t \u0111i\u1EC1u hi\u1EC3n
      nhi\xEAn. Pha tr\xE0. Pha c\xE0 ph\xEA h\xF2a tan. Hay th\u1EADm ch\xED ch\u1EC9
      l\xE0 \xE1p hai b\xE0n tay v\xE0o m\u1ED9t chi\u1EBFc c\u1ED1c \u1EA5m \xE1p.
      Gi\u1EDD \u0111\xE2y ch\xFAng t\xF4i l\u1EA1i ngh\u0129 \u0111\u1EBFn chuy\u1EC7n
      \u0111i\u1EC7n tho\u1EA1i n\u1EEFa. Khi m\u1EA5t \u0111i\u1EC7n, \u0111i\u1EC7n
      tho\u1EA1i c\u0169ng s\u1EBD s\u1EADp ngu\u1ED3n theo. Khi \u0111i\u1EC7n tho\u1EA1i
      ch\u1EBFt ng\xF3m, s\u1EBD ch\u1EB3ng c\xF2n m\u1EA1ng x\xE3 h\u1ED9i n\u1EEFa.
      Kh\xF4ng c\xF2n tin t\u1EE9c. Ch\u1EB3ng c\xF2n c\u1EA3 hy v\u1ECDng nh\u1EADn
      \u0111\u01B0\u1EE3c m\u1ED9t d\xF2ng tin nh\u1EAFn t\u1EEB ai \u0111\xF3. S\u1EBD
      kh\xF4ng c\xF2n m\u1ED9t c\xE1i g\xEC c\u1EA3. Ch\xFAng t\xF4i ch\u01B0a s\u1EB5n
      s\xE0ng \u0111\u1EC3 \u0111\u1ED1i m\u1EB7t v\u1EDBi s\u1EF1 im l\u1EB7ng \u0111\xE1ng
      s\u1EE3 \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 16969522211667968
    m_Localized: "Ai \u0111\xF3 \u0111\xE3 t\u1EEBng n\xF3i r\u1EB1ng: \"Con ng\u01B0\u1EDDi
      \xEDt l\xE0 ch\xEDnh m\xECnh nh\u1EA5t khi n\xF3i chuy\u1EC7n b\u1EB1ng danh
      ngh\u0129a c\u1EE7a b\u1EA3n th\xE2n. H\xE3y \u0111\u01B0a cho anh ta m\u1ED9t
      chi\u1EBFc m\u1EB7t n\u1EA1, v\xE0 anh ta s\u1EBD n\xF3i cho b\u1EA1n s\u1EF1
      th\u1EADt.\" Ch\u1EAFc ch\u1EAFn kh\xF4ng ph\u1EA3i l\xE0 Einstein r\u1ED3i.
      C\xF3 l\u1EBD l\xE0 c\u1EE7a m\u1ED9t nh\xE0 v\u0103n n\xE0o \u0111\xF3 m\xE0
      ch\xFAng t\xF4i \u0111\xE3 qu\xEAn b\u1EB5ng \u0111i c\xE1i t\xEAn. Nh\u01B0ng
      ch\xFAng t\xF4i c\u1EE9 suy ng\u1EABm m\xE3i v\u1EC1 c\xE2u n\xF3i \u0111\xF3.
      Ngay l\xFAc n\xE0y \u0111\xE2y, b\u1ED1n b\u1EE9c t\u01B0\u1EDDng n\xE0y ch\xEDnh
      l\xE0 chi\u1EBFc m\u1EB7t n\u1EA1 c\u1EE7a ch\xFAng t\xF4i. V\xE0 s\u1EF1 th\u1EADt
      l\xE0: c\u1EA3 l\u0169 \u0111ang s\u1EE3 ph\xE1t khi\u1EBFp. Th\u1EA3m h\u1ECDa
      th\u1EE9 hai \u0111ang c\u1EADn k\u1EC1 r\u1ED3i. N\u0103m ng\xE0y tr\u01B0\u1EDBc
      khi m\u1EA5t \u0111i\u1EC7n. Gi\u1EDD ch\u1EC9 c\xF2n b\u1ED1n. Ch\xFAng t\xF4i
      \u0111ang \u0111\u1EBFm ng\u01B0\u1EE3c t\u1EEBng ng\xE0y. M\u1ED7i bu\u1ED5i
      s\xE1ng th\u1EE9c d\u1EADy, suy ngh\u0129 \u0111\u1EA7u ti\xEAn l\xF3e l\xEAn
      trong \u0111\u1EA7u l\xE0: l\u1EA1i b\u1EDBt \u0111i m\u1ED9t ng\xE0y r\u1ED3i.
      Nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng c\u1EA3m gi\xE1c nh\u01B0 \u0111ang thu
      h\u1EB9p l\u1EA1i, \xE1p s\xE1t h\u01A1n so v\u1EDBi ng\xE0y h\xF4m qua. S\u1EF1
      im l\u1EB7ng th\xEC ng\xE0y m\u1ED9t n\u1EB7ng n\u1EC1 h\u01A1n. Ch\xFAng t\xF4i
      t\u1EEBng khao kh\xE1t \u0111\u01B0\u1EE3c b\u01B0\u1EDBc ra ngo\xE0i. C\xF2n
      b\xE2y gi\u1EDD, c\u1EA3 l\u0169 l\u1EA1i khi\u1EBFp s\u1EE3 nh\u1EEFng th\u1EE9
      \u0111ang r\xECnh r\u1EADp ngo\xE0i kia. Nh\u01B0ng ch\xFAng t\xF4i c\u0169ng
      kinh h\xE3i kh\xF4ng k\xE9m n\u1EBFu c\u1EE9 ti\u1EBFp t\u1EE5c ch\xF4n ch\xE2n
      trong c\u0103n ph\xF2ng n\xE0y. Ch\u1EB3ng c\xF3 l\u1EF1a ch\u1ECDn n\xE0o
      l\xE0 t\u1ED1t c\u1EA3. Ch\u1EC9 c\xF3 l\u1EF1a ch\u1ECDn \u0111\u1EE1 t\u1ED3i
      t\u1EC7 h\u01A1n m\xE0 th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 16971826625200128
    m_Localized: "Ch\xFAng t\xF4i \u0111\xF3n ch\xE0o ng\xE0y m\u1EDBi b\u1EB1ng
      m\u1ED9t tr\u1EADn m\u01B0a. Ngay c\u1EA3 trong th\u1EDDi k\u1EF3 t\u1EADn
      th\u1EBF th\xEC th\u1EDDi ti\u1EBFt \u1EDF c\xE1i x\u1EE9 n\xE0y v\u1EABn ch\u1EB3ng
      c\xF3 g\xEC thay \u0111\u1ED5i \u2014 h\xF4m tr\u01B0\u1EDBc v\u1EEBa n\u1EAFng
      v\u1EE1 \u0111\u1EA7u, h\xF4m sau \u0111\xE3 m\u01B0a nh\u01B0 tr\xFAt n\u01B0\u1EDBc.
      V\u1EABn \u1EA9m \u01B0\u1EDBt. V\u1EABn ng\u1ED9t ng\u1EA1t \u0111\u1EBFn
      b\u1EE9c b\u1ED1i. Nh\u01B0ng \xEDt nh\u1EA5t th\xEC c\u01A1n m\u01B0a c\u0169ng
      gi\xFAp m\u1ECDi th\u1EE9 d\u1ECBu m\xE1t \u0111i \u0111\xF4i ch\xFAt. T\u1EEB
      khung c\u1EEDa s\u1ED5 ph\xF2ng m\xECnh, ch\xFAng t\xF4i nh\xECn th\u1EA5y
      l\u0169 zombie tr\xEAn h\xE0nh lang c\u1EE7a t\xF2a nh\xE0 k\xFD t\xFAc x\xE1
      \u0111\u1ED1i di\u1EC7n. Th\xE1o th\u1EE9. Ch\u1EADm ch\u1EA1p. \u0110\u1EA7u
      c\u1EE7a t\u1EE5i n\xF3 c\u1EE9 gi\u1EADt gi\u1EADt li\xEAn h\u1ED3i, nhi\u1EC1u
      h\u01A1n h\u1EB3n so v\u1EDBi ng\xE0y th\u01B0\u1EDDng. C\xF3 l\u1EBD c\u01A1n
      m\u01B0a l\xE0m t\u1EE5i n\xF3 b\u1ED3n ch\u1ED3n. Ho\u1EB7c gi\u1EA3 l\xE0
      khi\u1EBFn t\u1EE5i n\xF3 c\u1EA3nh gi\xE1c h\u01A1n. Ch\xFAng t\xF4i bi\u1EBFt
      \u0111i\u1EC1u \u0111\xF3 v\xEC v\u1EEBa nh\xECn th\u1EA5y v\xE0i ng\u01B0\u1EDDi
      ph\xEDa d\u01B0\u1EDBi s\xE2n v\u01B0\u1EDDn \u2014 nh\u1EEFng ng\u01B0\u1EDDi
      c\xF2n s\u1ED1ng s\xF3t, h\u1ECD mang theo v\u0169 kh\xED v\xE0 \u0111ang r\xF3n
      r\xE9n l\xE1ch qua nh\u1EEFng t\xE1n c\xE2y. Ch\u1EAFc l\xE0 h\u1ECD \u0111ang
      t\xECm ki\u1EBFm th\u1EE9 g\xEC \u0111\xF3. \u0110\u1ED3 \u0103n, c\xF3 l\u1EBD
      v\u1EADy. Ch\xFAng t\xF4i \u0111\xE3 ngh\u0129 \u0111\u1EBFn chuy\u1EC7n g\u1ECDi
      v\u1EDBi xu\u1ED1ng \u0111\u1EC3 b\xE1o hi\u1EC7u cho h\u1ECD. Nh\u01B0ng ai
      m\xE0 bi\u1EBFt \u0111\u01B0\u1EE3c h\u1ECD mu\u1ED1n c\xE1i g\xEC ch\u1EE9?
      N\u1EBFu h\u1ECD ph\xE1t hi\u1EC7n ra ch\xFAng t\xF4i, bi\u1EBFt \u0111\xE2u
      h\u1ECD s\u1EBD c\u01B0\u1EDBp s\u1EA1ch s\u1ED1 nhu y\u1EBFu ph\u1EA9m \xEDt
      \u1ECFi n\xE0y th\xEC sao. Bi\u1EBFt \u0111\xE2u h\u1ECD th\xE2n thi\u1EC7n.
      M\xE0 bi\u1EBFt \u0111\xE2u h\u1ECD l\u1EA1i t\xE0n nh\u1EABn. Th\u1EBF n\xEAn
      ch\xFAng t\xF4i ch\u1EC9 \u0111\u1EE9ng nh\xECn. Ch\u1EB3ng n\xF3i m\u1ED9t
      l\u1EDDi. Gi\u1EEF im l\u1EB7ng tuy\u1EC7t \u0111\u1ED1i. Ti\u1EBFng m\u01B0a
      r\u01A1i \u0111\xE3 \xE1t \u0111i ti\u1EBFng b\u01B0\u1EDBc ch\xE2n c\u1EE7a
      h\u1ECD. C\xF2n ch\xFAng t\xF4i th\xEC v\u1EABn b\u1EA5t \u0111\u1ED9ng. Kh\xF4ng
      m\u1ED9t ti\u1EBFng \u0111\u1ED9ng n\xE0o ph\xE1t ra."
    m_Metadata:
      m_Items: []
  - m_Id: 16973811097223168
    m_Localized: "Nh\u1EDD tr\u1EADn m\u01B0a ng\xE0y h\xF4m qua, ch\xFAng t\xF4i
      \u0111\xE3 h\u1EE9ng \u0111\u01B0\u1EE3c kha kh\xE1 n\u01B0\u1EDBc m\u01B0a.
      S\u1ED1 n\u01B0\u1EDBc n\xE0y c\xF3 l\u1EBD s\u1EBD gi\xFAp ch\xFAng t\xF4i
      c\u1EA7m c\u1EF1 th\xEAm \u0111\u01B0\u1EE3c v\xE0i ng\xE0y n\u1EEFa, nh\u01B0ng
      n\u1ED7i tuy\u1EC7t v\u1ECDng t\u1EEB vi\u1EC7c s\u1EAFp m\u1EA5t \u0111i\u1EC7n
      v\u1EABn ch\u1EB3ng gi\u1EA3m b\u1EDBt \u0111i ch\xFAt n\xE0o. Ch\xFAng t\xF4i
      \u0111ang c\u1ED1 g\u1EAFng ch\xE9p l\u1EA1i nh\u1EEFng th\xF4ng tin thi\u1EBFt
      y\u1EBFu t\u1EEB \u0111i\u1EC7n tho\u1EA1i ra gi\u1EA5y, ph\xF2ng tr\u01B0\u1EDDng
      h\u1EE3p b\u1EA5t tr\u1EAFc. S\u1EA1c d\u1EF1 ph\xF2ng c\u0169ng \u0111\xE3
      \u0111\u01B0\u1EE3c n\u1EA1p \u0111\u1EA7y. Ch\u1EB3ng c\xF2n g\xEC ngo\xE0i
      vi\u1EC7c li\xEAn t\u1EE5c t\xECm c\xE1ch t\u1EF1 an \u1EE7i b\u1EA3n th\xE2n.
      D\xF9 sao th\xEC, c\xF2n c\xF3 th\u1EC3 c\xF3 chuy\u1EC7n g\xEC t\u1ED3i t\u1EC7
      h\u01A1n th\u1EBF n\xE0y \u0111\u01B0\u1EE3c n\u1EEFa ch\u1EE9?"
    m_Metadata:
      m_Items: []
  - m_Id: 16981242560856064
    m_Localized: "Ch\xFAng t\xF4i \u0111ang t\u1EADn h\u01B0\u1EDFng l\xE0n gi\xF3
      m\xE1t r\u01B0\u1EE3i t\u1EEB chi\u1EBFc qu\u1EA1t th\xEC \u2014 Ph\u1EF1t.
      M\u1ECDi th\u1EE9 d\u1EEBng l\u1EA1i. Nh\u1EEFng c\xE1nh qu\u1EA1t quay ch\u1EADm
      d\u1EA7n. Ti\u1EBFng \u0111\u1ED9ng c\u01A1 r\xEC r\xEC t\u1EAFt ng\u1EA5m.
      Im l\u1EB7ng. Nh\u01B0ng kh\xF4ng h\u1EB3n l\xE0 im l\u1EB7ng ho\xE0n to\xE0n.
      Gi\u1EDD \u0111\xE2y, ch\xFAng t\xF4i c\xF3 th\u1EC3 nghe th\u1EA5y ti\u1EBFng
      l\xE1 c\xE2y x\xE0o x\u1EA1c b\xEAn ngo\xE0i. Ti\u1EBFng gi\xF3 l\xF9a qua
      nh\u1EEFng d\u1EA3i h\xE0nh lang. Ti\u1EBFng chim ch\xF3c \u2014 k\xEAu to,
      s\u1EAFc l\u1EB9m v\xE0 nh\u1EE9c \xF3c. Tr\u01B0\u1EDBc \u0111\xE2y ch\xFAng
      t\xF4i ch\u01B0a t\u1EEBng \u0111\u1EC3 \xFD \u0111\u1EBFn t\u1EE5i n\xF3.
      C\xF2n b\xE2y gi\u1EDD, \u0111\xF3 l\xE0 t\u1EA5t c\u1EA3 nh\u1EEFng g\xEC
      ch\xFAng t\xF4i nghe th\u1EA5y. Ch\xFAng t\xF4i bi\u1EBFt ng\xE0y n\xE0y r\u1ED3i
      s\u1EBD \u0111\u1EBFn. B\u1EA3n th\xF4ng b\xE1o n\xF3i l\xE0 n\u0103m ng\xE0y.
      V\xE0 ch\xEDnh x\xE1c l\xE0 \u0111\xE3 n\u0103m ng\xE0y tr\xF4i qua. D\u1EABu
      v\u1EADy, khi \u0111\u1EE9ng tr\xE2n tr\xE2n gi\u1EEFa s\u1EF1 l\u1EB7ng ng\u1EAFt
      \u0111\u1ED9t ng\u1ED9t \u0111\xF3\u2026 c\u1EA3m gi\xE1c n\xF3 gi\xE1ng xu\u1ED1ng
      \u0111\u1EA7u c\xF2n n\u1EB7ng n\u1EC1 h\u01A1n t\u01B0\u1EDFng t\u01B0\u1EE3ng.
      Kh\xF4ng c\xF2n \xE1nh \u0111\xE8n. Kh\xF4ng c\xF2n s\u1EA1c pin. Kh\xF4ng
      c\xF2n qu\u1EA1t m\xE1y. Ch\u1EC9 c\xF2n ch\xFAng t\xF4i, c\xE1i n\xF3ng n\u1EF1c,
      v\xE0 b\u1EA5t c\u1EE9 \u0111i\u1EC1u g\xEC s\u1EAFp s\u1EEDa \u1EADp \u0111\u1EBFn
      ti\u1EBFp theo. K\u1EC3 t\u1EEB gi\u1EDD ph\xFAt n\xE0y, ch\xFAng t\xF4i ph\u1EA3i
      sinh t\u1ED3n th\u1EF1c s\u1EF1. Kh\xF4ng c\xF2n ph\u01B0\u01A1ng \xE1n d\u1EF1
      ph\xF2ng. Kh\xF4ng c\xF2n m\u1ED9t ch\xFAt ti\u1EC7n nghi. Ch\u1EC9 c\xF2n
      cu\u1ED9c chi\u1EBFn sinh t\u1ED3n tr\u1EA7n tr\u1EE5i, m\u1EC7t m\u1ECFi v\xE0
      \u0111\xF3i kh\xE1t. Th\u1EED th\xE1ch th\u1EF1c s\u1EF1 b\xE2y gi\u1EDD m\u1EDBi
      b\u1EAFt \u0111\u1EA7u."
    m_Metadata:
      m_Items: []
  - m_Id: 16982939374927872
    m_Localized: "Tr\u01B0\u1EDBc \u0111\xE2y ch\xFAng t\xF4i th\u01B0\u1EDDng \u0111\u1EC3
      m\u1ED9t chi\u1EBFc \u0111\xE8n ng\u1EE7 nh\u1ECF b\u1EADt s\xE1ng. Ch\u1EC9
      l\xE0 \u0111\u1EC3 bi\u1EBFt r\u1EB1ng m\xECnh v\u1EABn c\xF2n \u0111i\u1EC7n.
      M\u1ED9t \u0111\u1ED1m s\xE1ng nh\u1ECF nhoi n\u01A1i g\xF3c ph\xF2ng. B\u1EB1ng
      ch\u1EE9ng cho th\u1EA5y ch\xFAng t\xF4i ch\u01B0a ho\xE0n to\xE0n b\u1ECB
      c\xF4 l\u1EADp v\u1EDBi th\u1EBF gi\u1EDBi. Gi\u1EDD th\xEC n\xF3 t\u1EAFt
      ng\xF3m r\u1ED3i. Kh\xF4ng c\xF2n \xE1nh s\xE1ng. Ch\u1EB3ng c\xF2n b\u1EB1ng
      ch\u1EE9ng. S\xE1ng nay, l\u0169 v\u1ECBt l\u1EA1i b\u1EAFt \u0111\u1EA7u k\xEAu
      c\u1EA1p c\u1EA1p. M\u1EA5y ng\xE0y nay ch\xFAng t\xF4i to\xE0n l\u1EDD t\u1EE5i
      n\xF3 \u0111i, nh\u01B0ng h\xF4m nay ch\xFAng t\xF4i l\u1EA1i ng\u1ED3i l\u1EAFng
      nghe. Ch\xFAng t\xF4i \u0111o\xE1n t\u1EE5i n\xF3 gi\u1EDD l\xE0 ch\u01B0\u01A1ng
      tr\xECnh gi\u1EA3i tr\xED y\xEAu th\xEDch nh\u1EA5t c\u1EE7a ch\xFAng t\xF4i
      r\u1ED3i. V\u1EABn v\u1EADy th\xF4i \u2014 c\u1EE9 l\u1EA1ch b\u1EA1ch \u0111i
      l\u1EA1i quanh s\xE2n v\u01B0\u1EDDn nh\u01B0 th\u1EC3 c\xE1i ch\u1ED1n n\xE0y
      l\xE0 c\u1EE7a t\u1EE5i n\xF3 kh\xF4ng b\u1EB1ng. Th\u1EA3nh th\u01A1i. Ng\u1EA1o
      m\u1EA1n. \u1EDE c\xE1i khu\xF4n vi\xEAn tr\u01B0\u1EDDng n\xE0y, l\u0169 v\u1ECBt
      ch\u1EB3ng ng\xE1n m\u1ED9t c\xE1i g\xEC h\u1EBFt. \u0110\xF4i khi t\u1EE5i
      n\xF3 c\xF2n \u0111u\u1ED5i theo sinh vi\xEAn \u0111\u1EC3 \u0111\xF2i \u0111\u1ED3
      \u0103n. Ch\xFAng t\xF4i hay g\u1ECDi t\u1EE5i n\xF3 l\xE0 \"tr\xF9m tr\u01B0\u1EDDng\".
      \u0110\u1EA1i ca. \xD4ng tr\xF9m. Nh\u01B0ng c\xF3 g\xEC \u0111\xF3 sai sai.
      Ch\xFAng t\xF4i \u0111\u1EBFm th\u1EED. Thi\u1EBFu m\u1EA5t m\u1ED9t con. Kh\xF4ng
      ph\u1EA3i con b\xE9o nh\u1EA5t. L\xE0 m\u1ED9t con kh\xE1c. Ch\xFAng t\xF4i
      kh\xF4ng mu\u1ED1n ngh\u0129 ng\u1EE3i s\xE2u xa v\u1EC1 chuy\u1EC7n \u0111\xF3.
      Ch\xFAng t\xF4i \u0111\xE3 b\u1ECB b\u1ECF \u0111\xF3i qu\xE1 l\xE2u r\u1ED3i.
      N\u1EBFu c\xF3 ai \u0111\xF3 \u1EDF m\u1EA5y t\xF2a k\xFD t\xFAc x\xE1 kh\xE1c
      b\u1EAFt \u0111\u01B0\u1EE3c con v\u1ECBt \u0111\xF3 \u0111em \u0111i l\xE0m
      m\xF3n th\u1ECBt n\u01B0\u1EDBng\u2026 \u1EEB th\xEC. Nh\u01B0 v\u1EADy th\xEC
      b\u1EA5t k\xEDnh qu\xE1. Bu\u1ED3n c\u01B0\u1EDDi th\u1EADt \u0111\u1EA5y,
      nh\u01B0ng m\xE0 b\u1EA5t k\xEDnh kinh kh\u1EE7ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16986773501460480
    m_Localized: "\u0110\xEAm qua, \xE1nh tr\u0103ng tr\xF2n v\xE0 s\xE1ng r\u1EF1c.
      K\u1EC3 t\u1EEB khi m\u1EA5t \u0111i\u1EC7n, tr\u0103ng \u0111\xE3 tr\u1EDF
      th\xE0nh ni\u1EC1m hy v\u1ECDng duy nh\u1EA5t c\u1EE7a ch\xFAng t\xF4i v\xE0o
      ban \u0111\xEAm \u2014 l\u01B0\u1EE3ng \xE1nh s\xE1ng v\u1EEBa v\u1EB7n \u0111\u1EE7
      \u0111\u1EC3 nh\xECn r\xF5 g\u01B0\u01A1ng m\u1EB7t c\u1EE7a nhau. L\u0169
      zombie h\xECnh nh\u01B0 c\u0169ng ch\u1EB3ng nh\xECn t\u1ED1t l\u1EAFm trong
      b\xF3ng t\u1ED1i. Th\u1EBF n\xEAn ch\xFAng t\xF4i h\xE9 m\u1EDF r\xE8m c\u1EEDa
      m\u1ED9t ch\xFAt. Ch\u1EC9 m\u1ED9t ch\xFAt th\xF4i. \u0110\u1EC3 \xE1nh tr\u0103ng
      len l\u1ECFi v\xE0o ph\xF2ng. Ch\u1EB3ng \u0111\xE1ng l\xE0 bao. Nh\u01B0ng
      c\xF3 v\u1EABn h\u01A1n kh\xF4ng. Ch\xFAng t\xF4i v\u1EABn duy tr\xEC th\xF3i
      quen c\u0169 \u2014 c\u1EE9 ba ng\xE0y l\u1EA1i g\u1ECDi \u0111i\u1EC7n v\u1EC1
      nh\xE0 m\u1ED9t l\u1EA7n. M\u1ED9t ni\u1EC1m hy v\u1ECDng mong manh r\u1EB1ng
      s\u1EBD c\xF3 ai \u0111\xF3 nh\u1EA5c m\xE1y. M\u1EB9. B\u1ED1. B\u1EA5t k\u1EF3
      ai c\u0169ng \u0111\u01B0\u1EE3c. Nh\u01B0ng t\u1EA5t c\u1EA3 nh\u1EEFng g\xEC
      nh\u1EADn l\u1EA1i ch\u1EC9 l\xE0 nh\u1EEFng ti\u1EBFng chu\xF4ng reo. Nh\u1EEFng
      ti\u1EBFng chu\xF4ng d\xE0i b\u1EA5t t\u1EADn. Kh\xF4ng h\u1ED9p th\u01B0 tho\u1EA1i.
      Kh\xF4ng l\u1EDDi ph\u1EA3n h\u1ED3i. Ch\u1EC9 c\xF3 ti\u1EBFng t\xFAt t\xFAt
      c\u1EE7a m\u1ED9t \u0111\u01B0\u1EDDng d\xE2y v\xF4 \u0111\u1ECBnh. Ch\xFAng
      t\xF4i c\xFAp m\xE1y v\xE0 t\u1EF1 tr\u1EA5n an b\u1EA3n th\xE2n r\u1EB1ng
      m\u1ECDi ng\u01B0\u1EDDi \u1EDF nh\xE0 v\u1EABn \u1ED5n. H\u1ECD b\u1EAFt bu\u1ED9c
      ph\u1EA3i \u1ED5n."
    m_Metadata:
      m_Items: []
  - m_Id: 17029210672414720
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i b\u1EAFt \u0111\u1EA7u suy ngh\u0129
      m\xF4ng lung. Tr\u01B0\u1EDDng \u0111\u1EA1i h\u1ECDc c\u1EE7a ch\xFAng t\xF4i
      n\u1EB1m \u1EDF m\u1ED9t n\u01A1i h\u1EBBo l\xE1nh, kh\u1EC9 ho c\xF2 g\xE1y.
      Bi\u1EC7t l\u1EADp. C\xE1ch xa m\u1ECDi th\u1EE9. \u0110\u1EBFn n\xF4ng n\u1ED7i
      n\xE0y th\xEC b\u1EA5t k\u1EF3 ai c\xF2n s\u1ED1ng s\xF3t ch\u1EAFc c\u0169ng
      \u0111\xE3 tr\u1ED1n \u1EDF m\u1ED9t n\u01A1i n\xE0o \u0111\xF3 an to\xE0n
      h\u01A1n, ho\u1EB7c l\xE0 \u0111\xE3 di t\u1EA3n \u0111i h\u1EBFt c\u1EA3 r\u1ED3i.
      Ai l\u1EA1i l\u1EB7n l\u1ED9i \u0111\u01B0\u1EDDng s\xE1 xa x\xF4i ra t\u1EADn
      ngo\xE0i n\xE0y \u0111\u1EC3 t\xECm \u0111\u1ED3 \u0103n c\u01A1 ch\u1EE9?
      Ch\u1EAFc l\xE0 ch\u1EB3ng c\xF3 ai \u0111\xE2u. \u1EA4y v\u1EADy m\xE0\u2026
      ch\xFAng t\xF4i v\u1EABn c\u1EE9 hy v\u1ECDng. V\u1EABn quan s\xE1t. V\u1EABn
      c\u0103ng tai ra l\u1EAFng nghe b\u1EA5t k\u1EF3 d\u1EA5u hi\u1EC7u n\xE0o
      c\u1EE7a m\u1ED9t s\u1EF1 s\u1ED1ng kh\xE1c. M\u1ED9t gi\u1ECDng n\xF3i. M\u1ED9t
      b\u01B0\u1EDBc ch\xE2n. M\u1ED9t \xE1nh \u0111\xE8n b\xEAn khung c\u1EEDa s\u1ED5
      kh\xE1c. Ch\u1EC9 \u0111\u1EC3 ch\u1EE9ng minh r\u1EB1ng ch\xFAng t\xF4i kh\xF4ng
      ph\u1EA3i l\xE0 nh\u1EEFng ng\u01B0\u1EDDi duy nh\u1EA5t c\xF2n s\xF3t l\u1EA1i
      tr\xEAn \u0111\u1EDDi. B\u1EA7u tr\u1EDDi h\xF4m nay \u0111\u1EA7y m\xE2y \xE2m
      u. N\u1EB7ng tr\u0129u. D\xE0y \u0111\u1EB7c. Gi\u1ED1ng nh\u01B0 \u0111\u1EA7u
      \xF3c c\u1EE7a c\u1EA3 l\u0169 l\xFAc n\xE0y v\u1EADy. Qu\xE1 nhi\u1EC1u suy
      ngh\u0129. Qu\xE1 nhi\u1EC1u c\xE2u h\u1ECFi. Nh\u01B0ng ch\u1EB3ng c\xF3 l\u1EA5y
      m\u1ED9t c\xE2u tr\u1EA3 l\u1EDDi. Ch\xFAng t\xF4i ng\u1ED3i l\u1EB7ng thinh
      b\xEAn nhau su\u1ED1t m\u1ED9t th\u1EDDi gian d\xE0i. Ch\u1EC9 bi\u1EBFt tr\xE2n
      tr\xE2n nh\xECn ra ngo\xE0i c\u1EEDa s\u1ED5. Ch\u1EDD \u0111\u1EE3i m\u1ED9t
      \u0111i\u1EC1u g\xEC \u0111\xF3 c\xF3 l\u1EBD s\u1EBD ch\u1EB3ng bao gi\u1EDD
      \u0111\u1EBFn."
    m_Metadata:
      m_Items: []
  - m_Id: 17030520339644416
    m_Localized: "C\xE1i n\xF3ng th\u1EADt s\u1EF1 kh\xF4ng th\u1EC3 n\xE0o ch\u1ECBu
      \u0111\u1EF1ng n\u1ED5i. Kh\xF4ng qu\u1EA1t. Kh\xF4ng \u0111i\u1EC1u h\xF2a.
      Ch\u1EB3ng c\xF3 b\u1EA5t c\u1EE9 th\u1EE9 g\xEC \u0111\u1EC3 xua \u0111i b\u1EA7u
      kh\xF4ng kh\xED h\u1EA7m h\u1EADp n\xE0y. C\u1EA3 l\u0169 n\u1EB1m b\xF2 ra
      s\xE0n nh\xE0 su\u1ED1t c\u1EA3 ng\xE0y, kh\xF4ng d\xE1m nh\xFAc nh\xEDch.
      C\u1EED \u0111\u1ED9ng l\xE0 s\u1EBD \u0111\u1ED5 m\u1ED3 h\xF4i. \u0110\u1ED5
      m\u1ED3 h\xF4i l\xE0 s\u1EBD kh\xE1t n\u01B0\u1EDBc. M\xE0 kh\xE1t n\u01B0\u1EDBc
      th\xEC ph\u1EA3i u\u1ED1ng n\u01B0\u1EDBc. Ch\xFAng t\xF4i l\u1EA1i kh\xF4ng
      c\xF3 \u0111\u1EE7 n\u01B0\u1EDBc. Th\u1EBF l\xE0 c\u1EA3 l\u0169 c\u1EE9 n\u1EB1m
      im b\u1EA5t \u0111\u1ED9ng. Tay ch\xE2n dang r\u1ED9ng. M\u1EAFt m\u1EDF tr\u1EEBng
      tr\u1EEBng. H\u1EBFt nh\xECn ch\u1EB1m ch\u1EB1m l\xEAn tr\u1EA7n nh\xE0, l\u1EA1i
      nh\xECn ra b\u1EA7u tr\u1EDDi ngo\xE0i c\u1EEDa s\u1ED5. V\u1EABn s\u1EAFc
      xanh \u0111\xF3. V\u1EABn \xE1nh n\u1EAFng \u0111\xF3. V\u1EABn c\xE1i n\xF3ng
      n\u1EF1c \u0111\xF3. \u0110\u1EBFn c\u1EA3 nh\u1EEFng \u0111\xE1m m\xE2y b\xE2y
      gi\u1EDD c\u0169ng ch\u1EB3ng th\xE8m bay qua n\u1EEFa r\u1ED3i. Ch\xFAng t\xF4i
      kh\xF4ng n\xF3i chuy\u1EC7n. N\xF3i chuy\u1EC7n ch\u1EC9 t\u1ED5 t\u1ED1n n\u0103ng
      l\u01B0\u1EE3ng. T\u1ED1n n\u0103ng l\u01B0\u1EE3ng th\xEC l\u1EA1i hao n\u01B0\u1EDBc.
      C\u1EA3 l\u0169 ch\u1EC9 \u0111ang t\u1ED3n t\u1EA1i. Th\u1EDF. Ch\u1EDD \u0111\u1EE3i.
      V\xE0 nh\xECn v\u1EC7t n\u1EAFng d\u1ECBch chuy\u1EC3n d\u1EA7n tr\xEAn s\xE0n
      nh\xE0. T\u1EEBng gi\u1EDD, t\u1EEBng gi\u1EDD m\u1ED9t. \u0110\xF3 l\xE0 to\xE0n
      b\u1ED9 ng\xE0y d\xE0i c\u1EE7a ch\xFAng t\xF4i l\xFAc n\xE0y. Sinh t\u1ED3n
      b\u1EB1ng c\xE1ch kh\xF4ng l\xE0m g\xEC c\u1EA3."
    m_Metadata:
      m_Items: []
  - m_Id: 17031071206948864
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i nghe th\u1EA5y ti\u1EBFng \u0111\u1ED9ng
      g\xEC \u0111\xF3. T\u1EEB m\u1ED9t n\u01A1i r\u1EA5t xa. M\u1ED9t ti\u1EBFng
      r\u1EA7m. R\u1ED3i l\u1EA1i m\u1ED9t ti\u1EBFng n\u1EEFa. Ti\u1EBFng kim lo\u1EA1i?
      Hay ti\u1EBFng g\u1ED7 v\u1EE1? Th\u1EADt kh\xF3 \u0111\u1EC3 ph\xE2n bi\u1EC7t.
      C\xF3 th\u1EC3 l\xE0 ng\u01B0\u1EDDi s\u1ED1ng s\xF3t. C\xF3 th\u1EC3 l\xE0
      zombie. Ho\u1EB7c c\u0169ng c\xF3 th\u1EC3 ch\u1EB3ng l\xE0 g\xEC c\u1EA3.
      Ch\xFAng t\xF4i \u0111\xE3 c\u0103ng tai ra nghe su\u1ED1t m\u1ED9t h\u1ED3i
      l\xE2u. Nh\u01B0ng kh\xF4ng c\xF3 th\xEAm b\u1EA5t k\u1EF3 \xE2m thanh n\xE0o
      n\u1EEFa. \u0110\u1EC3 \u0111\xE1nh l\u1EA1c h\u01B0\u1EDBng b\u1EA3n th\xE2n,
      c\xF3 \u0111\u1EE9a nh\u1EB7t l\xEAn m\u1ED9t cu\u1ED1n s\xE1ch c\u0169 m\xE0
      c\u1EA3 l\u0169 ch\u01B0a bao gi\u1EDD \u0111\u1ECDc h\u1EBFt. Cu\u1ED1n s\xE1ch
      k\u1EC3 v\u1EC1 m\u1ED9t c\u1EADu b\xE9 b\u1ECB m\u1EAFc k\u1EB9t tr\xEAn bi\u1EC3n
      c\xF9ng v\u1EDBi m\u1EA5y con th\xFA. C\u1EADu ta tr\xF4i d\u1EA1t. C\u1EADu
      ta ch\u1EDD \u0111\u1EE3i. V\u1EC1 ph\xEDa cu\u1ED1i truy\u1EC7n, c\u1EADu
      ta b\u1EAFt \u0111\u1EA7u nh\xECn th\u1EA5y nh\u1EEFng \u1EA3o \u1EA3nh. T\u1EF1
      n\xF3i chuy\u1EC7n m\u1ED9t m\xECnh. T\u1EF1 \u0111\u1ED1i tho\u1EA1i v\u1EDBi
      m\u1ED9t h\u01B0 v\xF4 kh\xF4ng \u0111\u1ECBnh h\xECnh. Ch\xFAng t\xF4i \u0111\u1ECDc
      v\xE0i trang r\u1ED3i l\u1EA1i \u0111\u1EB7t cu\u1ED1n s\xE1ch xu\u1ED1ng.
      Ch\xFAng t\xF4i hy v\u1ECDng m\xECnh s\u1EBD kh\xF4ng ph\xE1t \u0111i\xEAn.
      \xCDt nh\u1EA5t l\xE0 ch\u01B0a ph\u1EA3i l\xFAc n\xE0y. Nh\u01B0ng nh\u1EEFng
      ng\xE0y nh\u01B0 th\u1EBF n\xE0y \u2014 c\xE1i n\xF3ng, s\u1EF1 im l\u1EB7ng,
      v\xE0 vi\u1EC7c ch\u1EDD \u0111\u1EE3i \u2014 c\u1EE9 khi\u1EBFn b\u1EA1n ph\u1EA3i
      t\u1EF1 h\u1ECFi r\u1EB1ng, li\u1EC7u t\xE2m tr\xED m\u1ED9t con ng\u01B0\u1EDDi
      c\xF3 th\u1EC3 tr\u1EE5 v\u1EEFng \u0111\u01B0\u1EE3c bao l\xE2u."
    m_Metadata:
      m_Items: []
  - m_Id: 17031777032814592
    m_Localized: "Tr\u01B0\u1EDBc \u0111\xE2y, ban ng\xE0y \u0111\u1ED3ng ngh\u0129a
      v\u1EDBi s\u1EF1 an to\xE0n. Ch\xFAng t\xF4i c\xF3 th\u1EC3 nh\xECn th\u1EA5y
      l\u0169 zombie \u0111ang lao t\u1EDBi. C\xF3 th\u1EC3 n\xE9 tr\xE1nh \u0111\u01B0\u1EE3c
      b\u1EA5t k\u1EF3 m\u1ED1i nguy hi\u1EC3m n\xE0o s\u1EAFp \u1EADp \u0111\u1EBFn.
      C\xF2n b\xE2y gi\u1EDD, m\u1EB7t tr\u1EDDi c\u0169ng ch\u1EC9 l\xE0 m\u1ED9t
      k\u1EBB th\xF9 kh\xE1c m\xE0 th\xF4i. H\xF4m nay tr\u1EDDi kh\xF4ng n\u1EAFng
      g\u1EAFt. Ch\u1EC9 l\xE0\u2026 r\u1EA5t kh\xF3 ch\u1ECBu. C\xE1i ki\u1EC3u
      n\xF3ng kh\xF4ng thi\xEAu \u0111\u1ED1t da th\u1ECBt nh\u01B0ng l\u1EA1i khi\u1EBFn
      ng\u01B0\u1EDDi ta b\u1ED3n ch\u1ED3n. B\u1EF1c d\u1ECDc. C\u1EA3m gi\xE1c
      nh\u01B0 b\u1ECB c\u1EA7m t\xF9 trong ch\xEDnh c\u01A1 th\u1EC3 m\xECnh. C\u1EA3
      l\u0169 n\u1EB1m l\u0103n l\xF3c, kh\xF4ng bu\u1ED3n nh\xFAc nh\xEDch, ch\u1EC9
      l\u1EB7ng l\u1EBD \u0111\u1ED5 m\u1ED3 h\xF4i. Ai \u0111\xF3 th\u1ED1t l\xEAn
      khe kh\u1EBD: \"\u01AF\u1EDBc g\xEC l\xFAc n\xE0y c\xF3 m\u1ED9t c\u1ED1c sinh
      t\u1ED1 rau th\xEC b\u1EA3o tao l\xE0m g\xEC tao c\u0169ng l\xE0m.\" M\xE1t
      l\u1EA1nh. Xanh t\u01B0\u01A1i. Thanh m\xE1t. T\u1EA5t c\u1EA3 ch\xFAng t\xF4i
      \u0111\u1EC1u b\u1EADt c\u01B0\u1EDDi. R\u1ED3i ch\u1EE3t t\u1EAFt ng\u1EA5m.
      B\u1EDFi v\xEC ch\xFAng t\xF4i nh\u1EADn ra m\xECnh kh\xF4ng th\u1EF1c s\u1EF1
      \u0111ang c\u01B0\u1EDDi. Ch\u1EC9 l\xE0 \u0111ang th\u1EDF h\u1EAFt ra m\u1EA1nh
      h\u01A1n b\xECnh th\u01B0\u1EDDng m\xE0 th\xF4i. V\u1EC7t n\u1EAFng b\xF2 ch\u1EADm
      r\xE3i tr\xEAn s\xE0n nh\xE0. Ch\u1EADm ch\u1EA1p. C\u1ED1 \xFD. Nh\u01B0 th\u1EC3
      \u0111ang tr\xEAu ng\u01B0\u01A1i ch\xFAng t\xF4i. Ch\xFAng t\xF4i k\xE9o r\xE8m
      l\u1EA1i m\u1ED9t n\u1EEDa. B\u1EDBt \u0111i ch\xFAt \xE1nh s\xE1ng, gi\u1EA3m
      \u0111i ch\xFAt h\u01A1i n\xF3ng. V\xE0 c\u0169ng v\u01A1i \u0111i ch\xFAt
      hy v\u1ECDng."
    m_Metadata:
      m_Items: []
  - m_Id: 17032680225849344
    m_Localized: "H\xF4m nay c\xF3 ai \u0111\xF3 h\u1ECFi: \"Li\u1EC7u t\u1EE5i m\xECnh
      c\xF3 s\u1ED1ng s\xF3t n\u1ED5i kh\xF4ng?\" Im l\u1EB7ng. \u0110\xF3 ch\xEDnh
      l\xE0 c\xE2u tr\u1EA3 l\u1EDDi. Kh\xF4ng m\u1ED9t ai n\xF3i c\xF3. C\u0169ng
      ch\u1EB3ng ai b\u1EA3o kh\xF4ng. Ch\xFAng t\xF4i c\u1EE9 ng\u1ED3i tr\u01A1
      ra \u0111\xF3, nh\xECn v\xE0o v\xF4 \u0111\u1ECBnh. B\u1EA7u tr\u1EDDi l\u1EA1i
      \xE2m u \u0111\u1EA7y m\xE2y, nh\u01B0ng c\xE1i n\xF3ng d\u01B0\u1EDDng nh\u01B0
      ch\u1EB3ng th\xE8m b\u1EADn t\xE2m \u0111\u1EBFn \u0111i\u1EC1u \u0111\xF3.
      V\u1EABn h\u1EA7m h\u1EADp. V\u1EABn n\u1EB7ng n\u1EC1. V\u1EABn ng\u1ED9t
      ng\u1EA1t \u0111\u1EBFn ngh\u1EB9t th\u1EDF. Ch\xFAng t\xF4i nh\u1EDB chi\u1EBFc
      qu\u1EA1t m\xE1y nh\u01B0 nh\u1EDB m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n c\u0169.
      M\u1ED9t ng\u01B0\u1EDDi b\u1EA1n th\xE2n ch\xED c\u1ED1t. C\xE1i \u0111\u1EE9a
      lu\xF4n lu\xF4n b\u1EA3o v\u1EC7 v\xE0 ch\u1ED1ng l\u01B0ng cho m\xECnh. Gi\u1EDD
      th\xEC c\u1EA3 l\u0169 ch\u1EC9 bi\u1EBFt n\u1EB1m b\xF2 ra \u0111\xE2y, \u0111\u1EC3
      c\xE1i n\xF3ng ninh nh\u1EEB m\u1ED9t c\xE1ch ch\u1EADm r\xE3i. Nh\u01B0 m\u1EA5y
      c\xE2y x\xFAc x\xEDch ng\u01B0\u1EDDi ng\u1EADp trong ch\xEDnh m\u1ED3 h\xF4i
      c\u1EE7a m\xECnh. B\xE2y gi\u1EDD ch\xFAng t\xF4i \u0111\xE2m ra s\u1EE3 \xE1nh
      m\u1EB7t tr\u1EDDi. C\u1EE9 ph\u1EA3i n\xE9p m\xECnh v\xE0o nh\u1EEFng g\xF3c
      t\u1ED1i. K\xE9o r\xE8m c\u1EEDa che k\xEDn m\xEDt. Th\u1EA5y v\u1EC7t n\u1EAFng
      r\u1EDBt xu\u1ED1ng s\xE0n l\xE0 lo m\xE0 b\xF2 ra xa. Ngh\u0129 c\u0169ng
      h\xE0i, t\u1EA7m n\xE0y nh\xECn ch\xFAng t\xF4i ch\u1EB3ng kh\xE1c g\xEC l\u0169
      ma c\xE0 r\u1ED3ng. M\u1EA5y con ma c\xE0 r\u1ED3ng th\u1EA3m h\u1EA1i, \u0111\xF3i
      kh\xE1t v\xE0 nh\u1EC5 nh\u1EA1i m\u1ED3 h\xF4i. C\xF3 \u0111i\u1EC1u l\xE0
      kh\xF4ng c\xF3 m\u1EA5y chi\u1EBFc \xE1o cho\xE0ng ng\u1EA7u \u0111\xE9t th\xF4i."
    m_Metadata:
      m_Items: []
  - m_Id: 17033540402102272
    m_Localized: "B\xE2y gi\u1EDD ch\xFAng t\xF4i \u0111\xE3 ph\u1EA3i gi\u1EA3m
      xu\u1ED1ng c\xF2n m\u1ED9t b\u1EEFa m\u1ED9t ng\xE0y. Ch\u1EB3ng c\xF2n ai
      c\xF3 \u0111\u1EE7 n\u0103ng l\u01B0\u1EE3ng \u0111\u1EC3 t\xE1n g\u1EABu d\xF4ng
      d\xE0i n\u1EEFa. Ch\u1EC9 \u0103n. Ch\u1EC9 \u0111\u1EC3 s\u1ED1ng s\xF3t.
      Th\u1EBF r\u1ED3i \u2014 b\u1EB1ng m\u1ED9t c\xE1ch th\u1EA7n k\u1EF3 n\xE0o
      \u0111\xF3 \u2014 m\xF9i h\u01B0\u01A1ng \u1EA5y s\u1EF1c n\u1EE9c lao v\xE0o
      m\u0169i c\u1EA3 l\u0169. Th\u1ECBt l\u1EE3n quay. C\u1EE9 thoang tho\u1EA3ng
      trong kh\xF4ng kh\xED. V\u1ECB ng\u1ECDt ng\u1ECDt, \u0111\u1EADm \u0111\xE0,
      c\xE1i ki\u1EC3u m\xF9i th\u01A1m t\u1EEBng c\xF3 s\u1EE9c m\u1EA1nh k\xE9o
      tu\u1ED9t ch\xFAng t\xF4i ra kh\u1ECFi gi\u01B0\u1EDDng m\u1ED7i s\xE1ng. R\u1ED3i
      \u0111\u1EBFn c\u1EA3 m\xF9i n\u01B0\u1EDBc ch\u1EA5m n\u1EEFa. N\u01B0\u1EDBc
      m\u1EAFm, chanh, \u1EDBt, \u0111\u01B0\u1EDDng \u2014 m\u1ED9t s\u1EF1 c\xE2n
      b\u1EB1ng ho\xE0n h\u1EA3o. R\u1ED3i c\u1EA3 rau mu\u1ED1ng x\xE0o t\u1ECFi.
      Ch\u1EC9 ri\xEAng c\xE1i m\xF9i t\u1ECFi phi g\u1EB7p d\u1EA7u n\xF3ng th\xF4i
      \xE1. B\u1EE5ng d\u1EA1 c\u1EA3 l\u0169 b\u1EAFt \u0111\u1EA7u bi\u1EC3u t\xECnh
      d\u1EEF d\u1ED9i. L\u0169 ru\u1ED9t gan ra s\u1EE9c ch\u1ED1ng \u0111\u1ED1i
      m\u1EA5y phong l\u01B0\u01A1ng kh\xF4. Nguy\u1EC1n r\u1EE7a t\u1EE5i n\xF3.
      Ch\xFAng t\xF4i b\u1EAFt \u0111\u1EA7u m\u01A1 m\u1ED9ng h\xE3o huy\u1EC1n
      \u2014 gi\xE1 m\xE0 c\xF3 ai \u0111\xF3 n\xE9n \u0111\u01B0\u1EE3c t\u1EA5t
      c\u1EA3 nh\u1EEFng m\xF3n \u0103n tuy\u1EC7t v\u1EDDi \u0111\xF3 th\xE0nh d\u1EA1ng
      l\u01B0\u01A1ng kh\xF4 nh\u1EC9. Ch\xFAng t\xF4i th\u1EC1 s\u1EBD \u0111\u1EA7u
      t\u01B0 ngay l\u1EADp t\u1EE9c. K\u1EC3 c\u1EA3 khi kh\xF4ng c\xF3 ng\xE0y
      t\u1EADn th\u1EBF \u0111i ch\u0103ng n\u1EEFa. Ngh\u0129 \u0111\u1EBFn \u0111\xF3
      c\u1EA3 l\u0169 l\u1EA1i b\u1EADt c\u01B0\u1EDDi. R\u1ED3i sau \u0111\xF3 l\u1EA1i
      quay v\u1EC1 v\u1EDBi vi\u1EC7c nhai m\u1EA5y kh\u1ED1i l\u01B0\u01A1ng kh\xF4
      kh\xF4 kh\u1ED1c trong im l\u1EB7ng. C\xE1i m\xF9i h\u01B0\u01A1ng \u1EA5y
      bi\u1EBFn m\u1EA5t v\xE0o bu\u1ED5i tr\u01B0a. Ch\u1EAFc l\xE0 do ch\xFAng
      t\xF4i t\u1EF1 t\u01B0\u1EDFng t\u01B0\u1EE3ng ra th\xF4i. Ch\u1EAFc l\xE0
      v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 17034553146163200
    m_Localized: "H\xF4m nay ch\xFAng t\xF4i nh\xECn th\u1EA5y kh\xF3i. \u1EDE m\u1ED9t
      n\u01A1i xa t\u1EAFp. M\u1ED9t c\u1ED9t kh\xF3i x\xE1m m\u1ECFng manh v\u01B0\u01A1n
      l\xEAn gi\u1EEFa b\u1EA7u tr\u1EDDi \u1EA3m \u0111\u1EA1m. C\xF3 th\u1EC3 l\xE0
      con ng\u01B0\u1EDDi. C\xF3 th\u1EC3 l\xE0 m\u1ED9t \u0111\u1ED1ng l\u1EEDa
      tr\u1EA1i. C\xF3 th\u1EC3 l\xE0 m\u1ED9t ng\xF4i nh\xE0 \u0111ang ch\xE1y.
      Ho\u1EB7c c\u0169ng c\xF3 th\u1EC3 ch\u1EB3ng l\xE0 g\xEC c\u1EA3. Ch\xFAng
      t\xF4i \u0111\xE3 \u0111\u1EE9ng tr\xE2n tr\xE2n nh\xECn n\xF3 su\u1ED1t h\xE0ng
      gi\u1EDD li\u1EC1n. Nh\xECn n\xF3 m\u1EDD d\u1EA7n. Nh\xECn n\xF3 tan bi\u1EBFn
      h\u1EB3n. Ch\u1EB3ng bi\u1EBFt n\xEAn c\u1EA3m th\u1EA5y hy v\u1ECDng hay s\u1EE3
      h\xE3i n\u1EEFa. C\xF3 l\u1EBD l\xE0 c\u1EA3 hai. Ho\u1EB7c c\xF3 l\u1EBD l\xE0
      kh\xF4ng g\xEC c\u1EA3. Ch\xFAng t\xF4i \u0111\xE3 qu\xE1 m\u1EC7t m\u1ECFi
      v\u1EDBi vi\u1EC7c \u0111o\xE1n m\xF2 r\u1ED3i. C\u1EA3 l\u0169 ng\u1ED3i \u0111\xE2y
      v\xE0 \u01B0\u1EDBc ao m\u1ED9t tr\u1EADn m\u01B0a. M\u1ED9t c\u01A1n b\xE3o
      th\u1EF1c s\u1EF1. C\xE1i ki\u1EC3u b\xE3o s\u1EBD l\xE0m \u01B0\u1EDBt s\u0169ng
      m\u1ECDi th\u1EE9. Cu\u1ED1n tr\xF4i l\u1EDBp b\u1EE5i b\u1EB7m b\xE1m \u0111\u1EA7y
      tr\xEAn da th\u1ECBt. Nh\u1EA5n ch\xECm \u0111i nh\u1EEFng suy ngh\u0129. Nh\u1EEFng
      n\u1ED7i lo \xE2u. Nh\u1EEFng ni\u1EC1m s\u1EE3 h\xE3i t\u1ED9t c\xF9ng. Ch\u1EC9
      trong v\xE0i ti\u1EBFng \u0111\u1ED3ng h\u1ED3 th\xF4i c\u0169ng \u0111\u01B0\u1EE3c.
      H\xE3y \u0111\u1EC3 ti\u1EBFng s\u1EA5m s\xE9t g\u1EA7m vang \u0111\u1EC3 ch\xFAng
      t\xF4i kh\xF4ng ph\u1EA3i g\xE0o th\xE9t n\u1EEFa. H\xE3y \u0111\u1EC3 m\xE0n
      n\u01B0\u1EDBc che gi\u1EA5u \u0111i nh\u1EEFng gi\u1ECDt n\u01B0\u1EDBc m\u1EAFt.
      M\xE0 ch\xEDnh ch\xFAng t\xF4i c\u0169ng ch\u1EB3ng bi\u1EBFt li\u1EC7u m\xECnh
      c\xF2n gi\u1ECDt n\u01B0\u1EDBc m\u1EAFt n\xE0o kh\xF4ng n\u1EEFa. Ch\xFAng
      t\xF4i hy v\u1ECDng \u0111\xEAm nay. Ho\u1EB7c ng\xE0y mai. C\xF3 m\u01B0a
      th\xEC t\u1ED1t bi\u1EBFt m\u1EA5y. M\u01B0a s\u1EBD \u0111em l\u1EA1i c\u1EA3m
      gi\xE1c nh\u01B0 th\u1EBF gi\u1EDBi n\xE0y v\u1EABn c\xF2n b\u1EADn l\xF2ng
      \u0111\u1EBFn ch\xFAng t\xF4i. D\xF9 th\u1EF1c t\u1EBF c\xF3 th\u1EC3 kh\xF4ng
      ph\u1EA3i nh\u01B0 v\u1EADy."
    m_Metadata:
      m_Items: []
  - m_Id: 17035949656457216
    m_Localized: "C\u01A1n m\u01B0a \u0111\xE3 \u0111\u1EBFn. Kh\xF4ng ph\u1EA3i
      ch\u1EC9 l\xE0 m\u1ED9t tr\u1EADn m\u01B0a ph\xF9n \u2014 m\xE0 l\xE0 m\u1ED9t
      c\u01A1n b\xE3o th\u1EF1c s\u1EF1. S\u1EA5m s\xE9t g\u1EA7m vang, ch\u1EDBp
      gi\u1EADt li\xEAn h\u1ED3i, v\xE0 nh\u1EEFng tr\u1EADn gi\xF3 cu\u1ED3ng n\u1ED9
      x\xE9 to\u1EA1c qua c\xE1c l\xF9m c\xE2y. \u0110\xEAm qua tr\u1EDDi kh\xF4ng
      m\u1ED9t b\xF3ng sao. S\xE1ng nay ch\xFAng t\xF4i \u0111\xE3 bi\u1EBFt l\xE0
      tr\u1EDDi s\u1EBD m\u01B0a. V\xE0 n\xF3 \u0111\xE3 m\u01B0a th\u1EADt. C\u1EA3
      l\u0169 lao ra ban c\xF4ng r\u1ED3i \u0111\u1EC3 m\u1EB7c cho l\xE0n m\u01B0a
      tr\xFAt x\u1ED1i x\u1EA3 v\xE0o ng\u01B0\u1EDDi. T\u1EEBng g\xE1o n\u01B0\u1EDBc
      d\u1ED9i xu\u1ED1ng. L\u1EA1nh to\xE1t, r\xE1t bu\u1ED1t, nh\u01B0ng tuy\u1EC7t
      v\u1EDDi l\xE0m sao. C\u1EA3m gi\xE1c nh\u01B0 c\u01A1 th\u1EC3 ch\xFAng t\xF4i
      \u0111ang \u0111\u01B0\u1EE3c t\u1EA9y tr\u1EA7n v\u1EADy. L\u1EDBp b\u1EE5i
      b\u1EB7m. M\u1ED3 h\xF4i nh\u1EC5 nh\u1EA1i. Nh\u1EEFng chu\u1ED7i ng\xE0y
      d\xE0i n\u1EB1m b\u1EA5t \u0111\u1ED9ng. T\u1EA5t c\u1EA3 tan bi\u1EBFn. Ch\u1EC9
      trong m\u1ED9t kho\u1EA3nh kh\u1EAFc ng\u1EAFn ng\u1EE7i. \u0110\u1EA7u \xF3c
      c\u1EE7a c\u1EA3 l\u0169 c\u0169ng nh\u1EB9 nh\xF5m h\u01A1n h\u1EB3n. Nh\u1EEFng
      suy ngh\u0129 u \xE1m kh\xF4ng m\u1EA5t \u0111i, nh\u01B0ng t\u1EE5i n\xF3
      \u0111\xE3 ch\u1ECBu im l\u1EB7ng b\u1EDBt r\u1ED3i. Ch\xFAng t\xF4i kh\xF4ng
      bi\u1EBFt m\xECnh c\xF2n ph\u1EA3i sinh t\u1ED3n th\xEAm bao nhi\xEAu ng\xE0y
      n\u1EEFa \u0111\xE2y. 100 ng\xE0y \u01B0? \xCDt h\u01A1n? Hay nhi\u1EC1u h\u01A1n
      th\u1EBF? V\u1EABn ch\u1EB3ng ai hay bi\u1EBFt. Nh\u01B0ng ngay l\xFAc n\xE0y
      \u0111\xE2y, \u0111\u01B0\u1EE3c \u0111\u1EE9ng d\u01B0\u1EDBi m\xE0n m\u01B0a,
      l\u1EA7n \u0111\u1EA7u ti\xEAn c\u1EA3m nh\u1EADn \u0111\u01B0\u1EE3c m\xECnh
      \u0111ang th\u1EF1c s\u1EF1 s\u1ED1ng sau chu\u1ED7i tu\u1EA7n d\xE0i \u0111\u1EB1ng
      \u0111\u1EB5ng\u2026 nh\u01B0 th\u1EBF n\xE0y l\xE0 \u0111\u1EE7 r\u1ED3i.
      Nh\u01B0 th\u1EBF n\xE0y l\xE0 qu\xE1 \u0111\u1EE7 r\u1ED3i."
    m_Metadata:
      m_Items: []
  - m_Id: 17037122425798656
    m_Localized: "C\u01A1n m\u01B0a \u0111\xE3 t\u1EA1nh. Kh\xF4ng kh\xED l\u1EA1i
      tr\u1EDF n\xEAn trong l\xE0nh \u2014 s\u1EA1ch s\u1EBD h\u01A1n h\u1EB3n so
      v\u1EDBi nh\u1EEFng tu\u1EA7n qua. Ch\xFAng t\xF4i \u0111\u1EE9ng ngo\xE0i
      ban c\xF4ng, h\xEDt c\u0103ng l\u1ED3ng ng\u1EF1c b\u1EA7u kh\xF4ng kh\xED
      \u1EA5y, c\u1EA3m gi\xE1c g\u1EA7n nh\u01B0 \u0111\u01B0\u1EE3c tr\u1EDF l\u1EA1i
      l\xE0m m\u1ED9t con ng\u01B0\u1EDDi b\xECnh th\u01B0\u1EDDng. C\u1EA3 l\u0169
      \u0111\xE3 \u0111\u1EC3 b\u1EA3n th\xE2n t\u1EADn h\u01B0\u1EDFng kho\u1EA3nh
      kh\u1EAFc \u0111\xF3. C\xF3 l\u1EBD l\xE0 h\u01A1i qu\xE1 \u0111\xE0. S\xE1ng
      nay, ch\xFAng t\xF4i nh\xECn xu\u1ED1ng s\xE2n v\u01B0\u1EDDn. L\u1EDBp b\xF9n
      \u0111\u1EA5t m\u1EC1m nh\xE3o ra. V\xE0 k\xECa \u2014 nh\u1EEFng d\u1EA5u
      ch\xE2n hi\u1EC7n l\xEAn r\xF5 m\u1ED3m m\u1ED9t. R\xF5 nh\u01B0 ban ng\xE0y.
      Kh\xF4ng ph\u1EA3i c\u1EE7a ch\xFAng t\xF4i. \u0110\xEAm qua m\u01B0a r\u1EA5t
      to. \u0110\xE1ng l\u1EBD ra n\xF3 ph\u1EA3i cu\u1ED1n tr\xF4i m\u1ECDi d\u1EA5u
      v\u1EBFt r\u1ED3i m\u1EDBi ph\u1EA3i. Nh\u01B0ng nh\u1EEFng d\u1EA5u ch\xE2n
      n\xE0y c\xF2n r\u1EA5t m\u1EDBi. \u0110i\u1EC1u \u0111\xF3 \u0111\u1ED3ng ngh\u0129a
      v\u1EDBi vi\u1EC7c c\xF3 ai \u0111\xF3 \u0111\xE3 \u0111i qua \u0111\xE2y sau
      khi m\u01B0a t\u1EA1nh. H\u1ECD \u0111i v\xF2ng quanh s\xE2n v\u01B0\u1EDDn.
      Nh\xF2m ng\xF3. T\xECm ki\u1EBFm. Kh\xF4ng ph\u1EA3i ch\u1EC9 m\u1ED9t ng\u01B0\u1EDDi.
      M\xE0 l\xE0 m\u1ED9t nh\xF3m. Ch\xFAng t\xF4i \u0111\xE3 qu\xE1 ch\xECm \u0111\u1EAFm
      trong s\u1EF1 nh\u1EB9 nh\xF5m c\u1EE7a b\u1EA3n th\xE2n m\xE0 qu\xEAn m\u1EA5t
      ph\u1EA3i canh ph\xF2ng. Ch\xFAng t\xF4i s\u1EBD kh\xF4ng ph\u1EA1m ph\u1EA3i
      sai l\u1EA7m \u0111\xF3 m\u1ED9t l\u1EA7n n\xE0o n\u1EEFa."
    m_Metadata:
      m_Items: []
  - m_Id: 17038672481173504
    m_Localized: "\u0110\xEAm qua, c\xF3 ti\u1EBFng \u0111\u1ED9ng l\xE0m ch\xFAng
      t\xF4i t\u1EC9nh gi\u1EA5c. Kh\xF4ng ph\u1EA3i m\u1ED9t ti\u1EBFng th\xE9t.
      C\u0169ng kh\xF4ng ph\u1EA3i ti\u1EBFng g\u1EA7m g\u1EEB. Ch\u1EC9 l\xE0 m\u1ED9t
      ti\u1EBFng \"b\u1ECBch\" n\u1EB7ng n\u1EC1. R\u1ED3i l\u1EA1i m\u1ED9t ti\u1EBFng
      n\u1EEFa. Gi\u1ED1ng nh\u01B0 ti\u1EBFng g\u1EADy \u0111\u1EADp v\xE0o th\u1EE9
      g\xEC \u0111\xF3. Ch\u1EADm r\xE3i. C\xF3 ch\u1EE7 \u0111\xEDch. Ch\xFAng t\xF4i
      \u0111\xE3 k\xE9o r\xE8m c\u1EEDa che k\xEDn m\xEDt sau khi nh\xECn th\u1EA5y
      nh\u1EEFng d\u1EA5u ch\xE2n ng\xE0y h\xF4m qua \u2014 kh\xF4ng mu\u1ED1n b\u1EA5t
      k\u1EF3 ai d\xF2m ng\xF3 v\xE0o trong. Nh\u01B0ng \xE2m thanh \u0111\xF3 v\u1EABn
      xuy\xEAn qua nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng. R\xF5 m\u1ED3n m\u1ED9t.
      G\u1EA7n ngay s\xE1t. Qu\xE1 g\u1EA7n. Ch\xFAng t\xF4i ng\u1ED3i b\u1EADt d\u1EADy
      trong b\xF3ng t\u1ED1i, c\u0103ng tai ra nghe. N\xEDn th\u1EDF. Nh\u1EEFng
      ti\u1EBFng \"b\u1ECBch\" \u0111\xF3 d\u1EEBng l\u1EA1i. R\u1ED3i l\u1EA1i b\u1EAFt
      \u0111\u1EA7u vang l\xEAn. C\xE0ng l\xFAc c\xE0ng g\u1EA7n h\u01A1n. Sau \u0111\xF3,
      ch\xFAng t\xF4i kh\xF4ng t\xE0i n\xE0o ng\u1EE7 l\u1EA1i \u0111\u01B0\u1EE3c
      n\u1EEFa. C\u1EE9 ng\u1ED3i tr\u01A1 ra \u0111\xF3, l\u01B0ng t\u1EF1a ch\u1EB7t
      v\xE0o t\u01B0\u1EDDng, m\u1EAFt kh\xF4ng r\u1EDDi kh\u1ECFi c\xE1nh c\u1EEDa.
      N\u1ED7i s\u1EE3 h\xE3i \u0111\xE3 quay tr\u1EDF l\u1EA1i \u2014 c\xE1i th\u1EE9
      c\u1EA3m gi\xE1c m\xE0 ch\xFAng t\xF4i ng\u1EE1 \u0111\xE3 ch\xF4n v\xF9i t\u1EEB
      nhi\u1EC1u tu\u1EA7n tr\u01B0\u1EDBc. N\xF3 g\u1EB7m nh\u1EA5m v\xE0 nu\u1ED1t
      ch\u1EEDng c\u1EA3 s\u1EF1 ki\u1EC7t qu\u1EC7 c\u1EE7a c\u1EA3 l\u0169. Ch\xFAng
      t\xF4i th\u1EE9c tr\u1EAFng su\u1ED1t c\u1EA3 \u0111\xEAm. Ch\u1EDD \u0111\u1EE3i.
      Canh ch\u1EEBng. Kh\xF4ng c\xF3 chuy\u1EC7n g\xEC x\u1EA3y ra c\u1EA3. Nh\u01B0ng
      ch\u01B0a bao gi\u1EDD s\u1EF1 t\u0129nh l\u1EB7ng l\u1EA1i vang v\u1ECDng
      m\u1ED9t c\xE1ch \u0111\xE1ng s\u1EE3 \u0111\u1EBFn th\u1EBF."
    m_Metadata:
      m_Items: []
  - m_Id: 17039376998416384
    m_Localized: "Ch\xFAng t\xF4i l\u1EA5y h\u1EBFt can \u0111\u1EA3m \u0111\u1EC3
      h\xE9 m\u1EDF c\xE1nh c\u1EEDa. Ch\u1EC9 m\u1ED9t khe nh\u1ECF th\xF4i. V\u1EEBa
      \u0111\u1EE7 \u0111\u1EC3 nh\xECn ra ngo\xE0i h\xE0nh lang. Tr\u1ED1ng tr\u01A1n.
      Im l\xECm. Nh\u01B0ng \u0111\xF3 kh\xF4ng ph\u1EA3i l\xE0 m\u1ED9t s\u1EF1
      im l\u1EB7ng b\xECnh th\u01B0\u1EDDng \u2014 m\xE0 l\xE0 c\xE1i ki\u1EC3u im
      l\u1EB7ng khi\u1EBFn b\u1EA1n ph\u1EA3i n\u1ED5i da g\xE0. Gi\u1ED1ng nh\u01B0
      c\xF3 th\u1EE9 g\xEC \u0111\xF3 ngo\xE0i kia c\u0169ng \u0111ang n\xEDn th\u1EDF
      v\u1EADy. Ch\xFAng t\xF4i kh\xF4ng th\u1EC3 g\u1EA1t b\u1ECF \u0111\u01B0\u1EE3c
      c\xE1i c\u1EA3m gi\xE1c r\u1EB1ng h\u1ECD bi\u1EBFt ch\xFAng t\xF4i \u0111ang
      \u1EDF b\xEAn trong. \u0110ang quan s\xE1t. \u0110ang ch\u1EDD \u0111\u1EE3i.
      C\xF3 l\u1EBD l\xE0 \u0111ang t\xEDnh to\xE1n xem ch\xFAng t\xF4i c\xF2n bao
      nhi\xEAu \u0111\u1ED3 \u0103n. C\xF3 bao nhi\xEAu \u0111\u1EE9a. Tr\xF4ng ch\xFAng
      t\xF4i ki\u1EC7t qu\u1EC7 \u0111\u1EBFn m\u1EE9c n\xE0o. Ch\xFAng t\xF4i k\xE9o
      c\u1EEDa \u0111\xF3ng s\u1EADp l\u1EA1i. Kh\xF3a ch\u1EB7t. R\u1ED3i ng\u1ED3i
      th\u1EE5p xu\u1ED1ng g\xF3c ph\xF2ng. Kh\xF4ng ai n\xF3i m\u1ED9t l\u1EDDi.
      Kh\xF4ng ai d\xE1m nh\xFAc nh\xEDch. Ngay c\u1EA3 ti\u1EBFng th\u1EDF c\u0169ng
      tr\u1EDF n\xEAn kh\u1EBD kh\xE0ng \u2014 nh\u1EEFng nh\u1ECBp th\u1EDF n\xF4ng,
      c\u1EA9n tr\u1ECDng, nh\u01B0 th\u1EC3 ch\xEDnh c\xE1nh c\u1EEDa kia c\u0169ng
      c\xF3 tai \u0111\u1EC3 nghe th\u1EA5y v\u1EADy. Nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng
      th\xEC qu\xE1 m\u1ECFng. S\u1EF1 im l\u1EB7ng th\xEC l\u1EA1i qu\xE1 d\xE0y.
      Ch\xFAng t\xF4i c\u1EE9 ng\u1ED3i im nh\u01B0 th\u1EBF su\u1ED1t h\xE0ng gi\u1EDD
      li\u1EC1n. Ch\u1EC9 bi\u1EBFt l\u1EAFng nghe. Ch\u1EC9 bi\u1EBFt ch\u1EDD \u0111\u1EE3i.
      Ch\u1EC9 bi\u1EBFt hy v\u1ECDng r\u1EB1ng c\xE1nh c\u1EEDa kia s\u1EBD kh\xF4ng
      ph\xE1t ra b\u1EA5t k\u1EF3 m\u1ED9t ti\u1EBFng \u0111\u1ED9ng n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 17042726284378112
    m_Localized: "Ch\xFAng t\xF4i \u0111\xE3 t\xEDnh \u0111\u1EBFn vi\u1EC7c \u0111\u1EA9y
      chi\u1EBFc t\u1EE7 qu\u1EA7n \xE1o ra ch\u1EB7n c\u1EEDa. Kh\xF3a ch\u1EB7t
      n\xF3 l\u1EA1i. N\u1ED9i b\u1EA5t xu\u1EA5t, ngo\u1EA1i b\u1EA5t nh\u1EADp.
      Nh\u01B0ng n\u1EBFu ch\u1EB7n c\xE1nh c\u1EEDa \u0111\xF3, ch\xFAng t\xF4i
      c\u0169ng t\u1EF1 tri\u1EC7t ti\xEAu l\u1ED1i tho\xE1t duy nh\u1EA5t c\u1EE7a
      ch\xEDnh m\xECnh. V\xE0 vi\u1EC7c \u0111\xF3 ch\u1EB3ng kh\xE1c n\xE0o \u0111ang
      th\xF4ng b\xE1o cho b\u1EA5t k\u1EF3 k\u1EBB n\xE0o \u1EDF b\xEAn ngo\xE0i
      bi\u1EBFt r\u1EB1ng \u2014 \u0111\xFAng v\u1EADy, c\xF3 ng\u01B0\u1EDDi \u0111ang
      tr\u1ED1n \u1EDF trong n\xE0y \u0111\xE2y. C\xF3 k\u1EBB \u0111\xE1ng \u0111\u1EC3
      ph\u1EA3i tr\u1ED1n tr\xE1nh. C\xF3 th\u1EE9 \u0111\xE1ng \u0111\u1EC3 ph\u1EA3i
      quay l\u1EA1i s\u0103n l\xF9ng. Ch\xFAng t\xF4i \u0111ang \u1EDF t\u1EA7ng
      5. Ch\u1EB3ng c\xF2n l\u1ED1i tho\xE1t n\xE0o kh\xE1c n\u1EEFa. Ch\u1EC9 c\xF3
      duy nh\u1EA5t c\xE1nh c\u1EEDa n\xE0y. Ch\u1EC9 c\xF3 c\u0103n ph\xF2ng n\xE0y.
      Ch\u01B0a \u0111\u1EA7y n\u0103m m\u01B0\u01A1i m\xE9t vu\xF4ng. N\u01A1i tr\xFA
      \u1EA9n an to\xE0n duy nh\u1EA5t c\u1EE7a ch\xFAng t\xF4i. V\xE0 c\u0169ng
      l\xE0 chi\u1EBFc b\u1EABy duy nh\u1EA5t giam c\u1EA7m c\u1EA3 l\u0169. B\u1EA7u
      tr\u1EDDi h\xF4m nay x\xE1m x\u1ECBt, \u0111\u1EA7y m\xE2y. N\u1EB7ng tr\u0129u.
      C\xE1i ki\u1EC3u m\xE2y b\xE1o hi\u1EC7u m\u1ED9t tr\u1EADn gi\xF4ng b\xE3o
      l\u1EDBn v\xE0o \u0111\xEAm nay. Ch\xFAng t\xF4i ng\u1ED3i b\xEAn c\u1EEDa
      s\u1ED5, nh\xECn \xE1nh s\xE1ng ng\xE0y l\u1ECBm d\u1EA7n. Trong \u0111\u1EA7u
      c\u1EE9 qu\u1EA9n quanh ngh\u0129 v\u1EC1 c\xE1nh c\u1EEDa. V\u1EC1 chi\u1EBFc
      t\u1EE7 qu\u1EA7n \xE1o. V\u1EC1 c\u01A1n m\u01B0a s\u1EAFp s\u1EEDa \u1EADp
      xu\u1ED1ng. Ch\xFAng t\xF4i v\u1EABn ch\u01B0a d\u1ECBch chuy\u1EC3n m\xF3n
      \u0111\u1ED3 \u0111\u1EA1c n\xE0o c\u1EA3. Nh\u01B0ng c\u1EA3 l\u0169 c\u0169ng
      ch\u01B0a h\u1EC1 lo\u1EA1i tr\u1EEB ph\u01B0\u01A1ng \xE1n \u0111\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 17043873380384768
    m_Localized: "\u0110\xEAm qua, m\u01B0a tr\xFAt xu\u1ED1ng d\u1EEF d\u1ED9i.
      S\u1EA5m s\xE9t, gi\xF3 r\xEDt, ti\u1EBFng n\u01B0\u1EDBc n\u1EC7n \u1EA7m
      \u1EA7m v\xE0o m\xE1i nh\xE0. Nh\u01B0ng \u1EA9n sau t\u1EA5t c\u1EA3 nh\u1EEFng
      t\u1EA1p \xE2m \u0111\xF3 \u2014 ch\xFAng t\xF4i nghe th\u1EA5y ti\u1EBFng
      b\u01B0\u1EDBc ch\xE2n. \u0110ang \u0111i l\xEAn c\u1EA7u thang. Ch\u1EADm
      r\xE3i. C\u1EA9n tr\u1ECDng. R\u1ED3i c\xF3 c\u1EA3 ti\u1EBFng th\xEC th\u1EA7m.
      Kh\xF4ng r\xF5 th\xE0nh l\u1EDDi. Ch\u1EC9 l\xE0 nh\u1EEFng \xE2m thanh r\xEC
      r\u1EA7m. Nh\u1EEFng gi\u1ECDng n\xF3i \u0111ang c\u1ED1 gi\u1EEF im l\u1EB7ng.
      Tim ch\xFAng t\xF4i nh\u01B0 ng\u1EEBng \u0111\u1EADp. R\u1ED3i l\u1EA1i \u0111\u1EADp
      lo\u1EA1n nh\u1ECBp li\xEAn h\u1ED3i. R\u1ED3i l\u1EA1i nh\u01B0 th\u1EAFt
      l\u1EA1i. M\u1ECDi d\xE2y th\u1EA7n kinh tr\xEAn c\u01A1 th\u1EC3 \u0111\u1EC1u
      c\u0103ng ra nh\u01B0 d\xE2y \u0111\xE0n. Ch\xFAng t\xF4i \u0111\u1EE9ng ch\xF4n
      ch\xE2n ngay s\xE1t c\xE1nh c\u1EEDa. C\u0103ng tai ra nghe. Ti\u1EBFng b\u01B0\u1EDBc
      ch\xE2n d\u1EEBng l\u1EA1i \u1EDF \u0111\xE2u \u0111\xF3 ph\xEDa cu\u1ED1i
      h\xE0nh lang. Ti\u1EBFng th\xEC th\u1EA7m nh\u1ECF d\u1EA7n r\u1ED3i t\u1EAFt
      h\u1EB3n. Nh\u01B0ng ch\xFAng t\xF4i kh\xF4ng d\xE1m nh\xFAc nh\xEDch. C\u1EA3
      l\u0169 ng\u1ED3i t\u1EF1a l\u01B0ng v\xE0o c\u1EEDa su\u1ED1t c\u1EA3 \u0111\xEAm.
      L\u01B0ng \xE1p ch\u1EB7t v\xE0o t\u1EA5m g\u1ED7. M\u1EAFt tr\u1EEBng tr\u1EEBng
      nh\xECn v\xE0o b\xF3ng t\u1ED1i. Ch\u1EDD \u0111\u1EE3i m\u1ED9t ti\u1EBFng
      g\xF5 c\u1EEDa \u1EADp \u0111\u1EBFn. \u0110\xE3 kh\xF4ng c\xF3 g\xEC x\u1EA3y
      ra c\u1EA3. Nh\u01B0ng ch\xFAng t\xF4i kh\xF4ng t\xE0i n\xE0o ch\u1EE3p m\u1EAFt
      n\u1ED5i. Kh\xF4ng m\u1ED9t gi\xE2y n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 17044983067394048
    m_Localized: "Ch\xFAng t\xF4i h\xE9 m\u1ED9t ch\xFAt r\xE8m c\u1EEDa h\u01B0\u1EDBng
      ra ban c\xF4ng r\u1ED3i nh\xECn xu\u1ED1ng. M\u1ED9t nh\xF3m \u0111\xE0n \xF4ng
      \u0111ang \u0111i b\u0103ng qua s\xE2n v\u01B0\u1EDDn. Vai \u0111eo ba l\xF4
      n\u1EB7ng tr\u0129u. Tay \xF4m kh\u1EC7 n\u1EC7 \u0111\u1EE7 th\u1EE9 \u0111\u1ED3
      \u2014 ch\u0103n m\xE0n, g\u1ED1i \xF4m, v\xE0 nh\u1EEFng t\xFAi tr\xF4ng gi\u1ED1ng
      nh\u01B0 l\u01B0\u01A1ng th\u1EF1c. Ch\u1EAFc l\xE0 t\u1EEB c\u0103ng tin ra
      r\u1ED3i, c\xF3 l\u1EBD h\u1ECD \u0111\xE3 c\xE0n qu\xE9t n\u01A1i \u0111\xF3.
      V\xE9t s\u1EA1ch b\u1EA5t c\u1EE9 th\u1EE9 g\xEC c\xF2n s\xF3t l\u1EA1i. Ch\xFAng
      t\xF4i \u0111\u1EE9ng nh\xECn h\u1ECD di chuy\u1EC3n tho\u0103n tho\u1EAFt
      t\u1EEB g\xF3c t\u1ED1i n\xE0y sang g\xF3c t\u1ED1i kh\xE1c. C\u1EA9n tr\u1ECDng.
      Nhanh nh\u1EB9n. H\u1ECD bi\u1EBFt r\xF5 m\xECnh \u0111ang l\xE0m g\xEC. C\xF2n
      ch\xFAng t\xF4i th\xEC ch\u1EB3ng c\xF3 l\u1EA5y lo\u1EA1i d\u0169ng kh\xED
      \u0111\xF3. Kh\xF4ng c\xF2n n\u1EEFa. Ho\u1EB7c c\xF3 l\u1EBD l\xE0 ch\u01B0a
      bao gi\u1EDD c\xF3. Th\u1EBF l\xE0 c\u1EA3 l\u0169 l\u1EA1i ng\u1ED3i th\u1EE5p
      xu\u1ED1ng. Nh\u1EB7t m\u1EA5y phong l\u01B0\u01A1ng kh\xF4 l\xEAn. L\u1EB7ng
      l\u1EBD nhai. Kh\xF4ng ch\u0103n. Kh\xF4ng g\u1ED1i. V\u1EABn ch\u1EC9 l\xE0
      nh\u1EEFng kh\u1ED1i l\u01B0\u01A1ng kh\xF4 c\u1EE9ng ng\u1EAFc c\xF9ng v\u1EDBi
      v\u1ECB \u0111\u1EAFng ng\u1EAFt c\u1EE7a s\u1EF1 h\u1ED1i h\u1EADn. \u0110\xE1ng
      l\u1EBD ra ch\xFAng t\xF4i \u0111\xE3 c\xF3 th\u1EC3 li\u1EC1u m\xECnh b\u01B0\u1EDBc
      ra ngo\xE0i kia. \u0110\xE1ng l\u1EBD \u0111\xE3 c\xF3 th\u1EC3 th\u1EED m\u1ED9t
      phen. Nh\u01B0ng ch\xFAng t\xF4i \u0111\xE3 kh\xF4ng l\xE0m v\u1EADy. V\xE0
      gi\u1EDD \u0111\xE2y, ch\xFAng t\xF4i ch\u1EC9 bi\u1EBFt tr\u01A1 m\u1EAFt
      \u0111\u1EE9ng nh\xECn."
    m_Metadata:
      m_Items: []
  - m_Id: 17048466940182528
    m_Localized: "\xDD ngh\u0129 v\u1EC1 vi\u1EC7c b\u1ECF c\u0103n ph\xF2ng n\xE0y
      \u0111\u1EC3 gia nh\u1EADp v\xE0o nh\xF3m ng\u01B0\u1EDDi \u0111\xF3 b\u1EAFt
      \u0111\u1EA7u nhen nh\xF3m trong t\xE2m tr\xED ch\xFAng t\xF4i. \u0110i theo
      h\u1ECD c\xF3 th\u1EC3 \u0111\u1ED3ng ngh\u0129a v\u1EDBi c\u01A1 h\u1ED9i
      s\u1ED1ng s\xF3t cao h\u01A1n, m\u1ED9t l\u1ED1i tho\xE1t kh\u1ECFi n\u1ED7i
      s\u1EE3 h\xE3i tri\u1EC1n mi\xEAn v\xE0 ng\u1ED9t ng\u1EA1t n\xE0y. Nh\u01B0ng
      n\u1EBFu ch\xFAng t\xF4i ph\u1EA3i ph\u1EE5c t\xF9ng m\u1ED9t k\u1EBB th\u1EE7
      l\u0129nh t\xE0n b\u1EA1o th\xEC sao? N\u1EBFu h\u1ECD \xE9p ch\xFAng t\xF4i
      ph\u1EA3i l\xE0m nh\u1EEFng chuy\u1EC7n kinh kh\u1EE7ng, \u0111\u1ED9c \xE1c
      th\xEC sao? \xDD ngh\u0129 \u0111\xF3 ch\u1EC9 c\xE0ng l\xE0m t\xE2m tr\xED
      ch\xFAng t\xF4i r\u1ED1i b\u1EDDi th\xE0nh m\u1ED9t m\u1EDB b\xF2ng bong, khi\u1EBFn
      c\u1EA3 l\u0169 ho\xE0n to\xE0n b\u1EBF t\u1EAFc kh\xF4ng bi\u1EBFt ph\u1EA3i
      l\xE0m g\xEC ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 17049198263222272
    m_Localized: "M\u1ED9t ti\u1EBFng th\xE9t x\xE9 to\u1EA1c kh\xF4ng gian. \u0110\u1ED9t
      ng\u1ED9t. S\u1EAFc l\u1EB9m. N\xF3 khi\u1EBFn c\u1EA3 l\u0169 gi\u1EADt b\u1EAFn
      m\xECnh. Ngay sau \u0111\xF3 l\xE0 nh\u1EEFng ti\u1EBFng g\u1EA7m g\u1EEB \u2014
      l\u0169 zombie. Ch\xFAng c\u0169ng \u0111\xE3 nghe th\u1EA5y ti\u1EBFng \u0111\u1ED9ng.
      Nhi\u1EC1u ti\u1EBFng h\xE9t h\u01A1n vang l\xEAn. Kh\xF4ng ph\u1EA3i ch\u1EC9
      m\u1ED9t ng\u01B0\u1EDDi. M\xE0 l\xE0 v\xE0i ng\u01B0\u1EDDi. R\u1ED3i \u0111\u1EBFn
      ti\u1EBFng \u0111\u1EADp ph\xE1 b\xF4m b\u1ED1p. Ti\u1EBFng ch\u1EEDi r\u1EE7a.
      Ti\u1EBFng c\u1EE7a th\u1EE9 g\xEC \u0111\xF3 n\u1EB7ng n\u1EC1 n\u1EC7n chan
      ch\xE1t v\xE0o da th\u1ECBt. M\u1ED9t ng\u01B0\u1EDDi \u0111\xE0n \xF4ng g\xE0o
      l\xEAn. M\u1ED9t ng\u01B0\u1EDDi kh\xE1c r\xFA l\xEAn \u0111au \u0111\u1EDBn.
      V\xE0 r\u1ED3i \u2014 th\u1EE9 \xE2m thanh kinh t\u1EDFm nh\u1EA5t xu\u1EA5t
      hi\u1EC7n. M\u1ED9t ti\u1EBFng x\xE9 to\u1EA1c \u1EA9m \u01B0\u1EDBt. Ti\u1EBFp
      theo l\xE0 ti\u1EBFng kh\xF3c l\xF3c. Kh\xF4ng c\xF2n ti\u1EBFng ch\u1ED1ng
      tr\u1EA3 n\u1EEFa. Ch\u1EC9 c\xF2n ti\u1EBFng kh\xF3c. Ch\xFAng t\xF4i \xE9p
      ch\u1EB7t ng\u01B0\u1EDDi v\xE0o t\u01B0\u1EDDng, l\u1EA5y tay b\u1ECBt ch\u1EB7t
      mi\u1EC7ng. Kh\xF4ng m\u1ED9t ai ph\xE1t ra ti\u1EBFng \u0111\u1ED9ng. Kh\xF4ng
      m\u1ED9t ai d\xE1m th\u1EDF. M\u1ED9t l\xFAc sau, nh\u1EEFng \xE2m thanh \u0111\xF3
      nh\u1ECF d\u1EA7n. Ti\u1EBFng g\u1EA7m g\u1EEB t\u1EAFt h\u1EB3n. Ti\u1EBFng
      kh\xF3c l\xF3c c\u0169ng kh\xF4ng c\xF2n. M\u1ECDi th\u1EE9 \u0111\xF4ng c\u1EE9ng
      l\u1EA1i. H\xF4m nay qu\u1EA3 th\u1EF1c l\xE0 \u0111\u1ECBa ng\u1EE5c. M\u1ED9t
      \u0111\u1ECBa ng\u1EE5c tr\u1EA7n gian ngay ngo\xE0i c\xE1nh c\u1EEDa c\u1EE7a
      ch\xFAng t\xF4i. Ch\xFAng t\xF4i kh\xF4ng nh\xECn th\u1EA5y n\xF3. Nh\u01B0ng
      \u0111\xE3 nghe th\u1EA5y t\u1EEBng gi\xE2y t\u1EEBng ph\xFAt. V\xE0 th\u1EE9
      \xE2m thanh \u0111\xF3 s\u1EBD \xE1m \u1EA3nh ch\xFAng t\xF4i m\xE3i m\xE3i."
    m_Metadata:
      m_Items: []
